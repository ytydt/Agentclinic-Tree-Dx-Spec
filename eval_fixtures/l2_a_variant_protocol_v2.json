  "audit_contract": {
    "tier_0": {
      "executor": "deterministic_script",
      "required_checks": [
        "topology",
        "hash_binding",
        "gold_leakage",
        "exact_duplicates",
        "schema",
        "active_reserve_partition",
        "cap_after_dedupe_hard_drop_rate",
        "adjudication_unit_uniqueness",
        "fixture_binding"
      ]
    },
    "tier_1": {
      "executor": "external_api_judge",
      "model": "gemma-4-31b",
      "transport": "RobustLLMClient_plus_CachedLLM",
      "sole_external_api_judge": true,
      "generation_model_self_judging_forbidden": true,
      "judges": [
        {
          "id": "LeafQualityJudge",
          "visible_fields": ["leaf_label", "parent_label", "same_tree_labels", "candidate_pool"],
          "hidden_fields": ["gold", "arm", "historical_results"],
          "outputs": ["is_specific_disease", "is_parent_valid", "confidence"]
        },
        {
          "id": "SemanticClusterJudge",
          "visible_fields": ["case_leaf_label_closed_set", "candidate_pool"],
          "hidden_fields": ["gold", "arm"],
          "outputs": ["semantic_cluster_members", "semantic_duplicate_excess", "confidence"]
        },
        {
          "id": "GoldMatchJudge",
          "stage": "evaluation_only_after_generation_is_frozen",
          "visible_fields": ["gold_diagnosis", "closed_set_leaf_ids_and_labels"],
          "hidden_fields": ["arm", "historical_results"],
          "outputs": ["acceptable_leaf_ids", "confidence"]
        }
      ],
      "offline_calibration": {
        "specific_cohen_kappa_min": 0.85,
        "parent_valid_cohen_kappa_min": 0.85,
        "semantic_duplicate_f1_min": 0.9,
        "gold_presence_sensitivity_min": 0.98,
        "acceptable_id_macro_f1_min": 0.95,
        "failure_or_api_unavailable_policy": "mark_all_gemma_adjudications_research_only_and_forbid_promotion"
      }
    },
    "tier_2": {
      "executor": "cursor_grok_4_5_initial_review",
      "model": "cursor-grok-4.5-high-fast",
      "review_is_blind_to_tier_1_output": true,
      "payload_must_equal_tier_1_blind_payload": true,
      "trigger_any": [
        "gemma_confidence_below_calibrated_threshold",
        "stratified_sentinel_sample",
        "extreme_gain_or_loss",
        "quality_performance_direction_conflict",
        "unknown_error_taxonomy",
        "new_leaf_parent_relation",
        "schema_edge_case",
        "reserve_reactivation_edge_case"
      ],
      "sentinel_fraction_range": [0.02, 0.05]
    },
    "agreement_rule": {
      "auto_accept_only_if_field_level_agreement": true,
      "both_confidences_must_pass_threshold": true,
      "otherwise_escalate": true
    },
    "tier_3": {
      "executor": "senior_human_domain_expert",
      "trigger": "any_field_disagreement_between_gemma_and_grok",
      "queue": "manual-escalation-queue",
      "unresolved_unit_counts_toward_promotion": false,
      "decision_is_final_gold": true
    }
  },
