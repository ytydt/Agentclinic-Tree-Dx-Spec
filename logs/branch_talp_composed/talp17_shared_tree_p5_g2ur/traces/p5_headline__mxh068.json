    {
      "id": "F1",
      "text": "Chief complaint: sore throat and breathing difficulties"
    },
    {
      "id": "F2",
      "text": "Symptoms developed two days ago: cough, congestion, runny nose, low-grade fever, and body aches"
    },
    {
      "id": "F3",
      "text": "Cough worsened and began producing yellow phlegm today"
    },
    {
      "id": "F4",
      "text": "Shortness of breath"
    },
    {
      "id": "F5",
      "text": "Mother noticed a “funny sound” with her breathing that started this afternoon"
    },
    {
      "id": "F6",
      "text": "Reduced appetite and minimal fluid intake"
    },
    {
      "id": "F7",
      "text": "Fully vaccinated, including for Covid-19"
    },
    {
      "id": "F8",
      "text": "SARS-CoV-2 testing is negative"
    },
    {
      "id": "F9",
      "text": "Temperature: 39.0°C"
    },
    {
      "id": "F10",
      "text": "Heart rate: 110 beats per minute"
    },
    {
      "id": "F11",
      "text": "Respiratory rate: 26 breaths per minute"
    },
    {
      "id": "F12",
      "text": "Oxygen saturation: 90% on room air"
    },
    {
      "id": "F13",
      "text": "Appears tired, anxious, and ill, with increased work of breathing"
    },
    {
      "id": "F14",
      "text": "Nasal congestion but no drooling"
    },
    {
      "id": "F15",
      "text": "Audible inspiratory stridor and moderate intercostal retractions"
    },
    {
      "id": "F16",
      "text": "No improvement with racemic epinephrine"
    },
    {
      "id": "F17",
      "text": "Breath sounds are present bilaterally without wheezing or rales"
    },
    {
      "id": "F18",
      "text": "toxic appearance, high fever and stridor after a viral prodrome with poor response to racemic epinephrine"
    },
    {
      "id": "F19",
      "text": "absence of drooling and ability to handle secretions"
    },
    {
      "id": "F20",
      "text": "failure to improve after nebulized epinephrine"
    },
    {
