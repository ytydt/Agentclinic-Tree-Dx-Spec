itutional symptoms but normal differential and elevated ALP are atypical for infection", "Myeloproliferative Neoplasm: Hypercalcemia and elevated ALP could be secondary to malignancy but not definitive for this category", "Lymphoma or Plasma Cell Dyscrasia: Hypercalcemia suggests possible malignancy, but WBC elevation is not a defining feature of these conditions"], "alarm_features": ["Unexplained weight loss", "Markedly elevated leukocyte count", "Hypercalcemia", "Constitutional fatigue with fever"]}, "branches": {"B1": {"id": "B1", "label": "Reactive / Non-malignant Leukocytosis", "level": 1, "status": "closed_for_now", "posterior": 0.017, "danger": 0.0, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B2": {"id": "B2", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.5370986320006048, "posterior": 0.5370986320006048, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.7, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute myeloid leukemia", "myelodysplastic syndrome with excess blasts", "chronic myeloid leukemia in blast crisis"]}, "B3": {"id": "B3", "label": "Chronic Myeloproliferative Neoplasm", "level": 1, "status": "parked", "posterior": 0.049, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B4": {"id": "B4", "label": "Lymphoid Neoplasm", "level": 1, "status": "parked", "posterior": 0.023, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B5": {"id": "B5", "label": "Plasma Cell Disorder", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.0, "posterior": 0.0, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.