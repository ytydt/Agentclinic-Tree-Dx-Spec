r ectasia within the liver"}], "seen_evidence_ids": [], "seen_evidence_phenotypes": "set()", "mode_policy": {"benchmark_purity": true, "allow_external_knowledge": true}, "answer_option_mapping": {}, "root_revision_needed": false, "max_tree_depth": 3, "reasoning_ledger": {"anchor": {}, "leader": {}, "leader_evidence": {}, "action_intents": [], "considered_alternatives": []}, "branch_knowledge": {"l1_classification_axis": "anatomy", "axis_rationale": "organ/anatomic source of the acute abdomen (gyn vs hepatobiliary vs pancreatic vs GI vascular), per Symptom-to-Diagnosis acute-abdomen framework.", "mandatory_coverage": ["gynecologic / pelvic", "hepatic / hepatobiliary vascular", "biliary obstruction", "pancreatic"], "candidate_entities_by_domain": {}, "syndrome_matched": "acute_abdomen_shock"}}
