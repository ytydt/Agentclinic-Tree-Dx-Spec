 >0.1 for untried tests."}, "turn_budget_used": 1, "estimated_remaining_value": 0.75, "max_turn_budget": 5, "latest_action_type": "ANALYZE_VIGNETTE", "diagnosis_readiness_score": 0.25334691846551194, "benchmark_output_ready": false, "static_question": "Which of the following is the most likely diagnosis?", "static_options": [{"id": "A", "description": "Acute lymphoblastic leukemia"}, {"id": "B", "description": "Acute myelogenous leukemia"}, {"id": "C", "description": "Chronic lymphocytic leukemia"}, {"id": "D", "description": "Chronic myelogenous leukemia"}, {"id": "E", "description": "Multiple myeloma"}], "seen_evidence_ids": [], "seen_evidence_phenotypes": "{'elevated red blood cell count', 'elevated white blood cell count', 'Pancytopenia'}", "mode_policy": {"benchmark_purity": true, "allow_external_knowledge": true}, "answer_option_mapping": {}, "root_revision_needed": false, "max_tree_depth": 3, "reasoning_ledger": {"anchor": {"hypothesis": "B1", "t": 0, "posterior_at_anchor": 0.591}, "leader": {"branch_id": "B1.1", "label": "De Novo Acute Myeloid Leukemia", "posterior": 0.253, "leading_since_t": 0, "n_revisions": 0}, "leader_evidence": {"confirming": 0, "disconfirming": 0, "last_disconfirming_digest": ""}, "action_intents": [{"t": 1, "intent": "broaden"}, {"t": 1, "intent": "broaden"}, {"t": 1, "intent": "broaden"}, {"t": 1, "intent": "broaden"}, {"t": 1, "intent": "broaden"}, {"t": 1, "intent": "broaden"}], "considered_alternatives": ["B1.2", "B1.3", "B2"]}}
