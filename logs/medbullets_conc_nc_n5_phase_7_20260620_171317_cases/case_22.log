entional weight loss"]}, "branches": {"B1": {"id": "B1", "label": "PTH-mediated (Parathyroid Hypercalcemia)", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.27272727272727276, "posterior": 0.30929850864742187, "danger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Elevated alkaline phosphatase is inconsistent with B4, weakly supporting PTH-mediated (B1) and malignancy (B2)."], "evidence_against": ["Absence of classic parathyroid symptoms weakens B1, while weight loss moderately favors malignancy (B2)."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.4, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B2": {"id": "B2", "label": "Malignancy-associated (PTHrP / Osteolytic Hypercalcemia)", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.6318526676654475, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Elevated alkaline phosphatase is inconsistent with B4, weakly supporting PTH-mediated (B1) and malignancy (B2)."], "evidence_against": ["Lack of paraneoplastic signs slightly reduces likelihood of malignancy (B2), but remains consistent with early-stage disease."], "unresolved_questions": [], "children": ["B2.1", "B2.2", "B2.3"], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.9, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B3": {"id": "B3", "label": "Vitamin-D / Granulomatous Hypercalcemia", "level": 1, "status": "closed_for_now", "posterior": 0.003, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B4": {"id": "B4", "label": "Other (Drug / Endocrine / Immobilization Hypercalcemia)", "level": 1, "status": "parked", "posterior": 0.056, "d