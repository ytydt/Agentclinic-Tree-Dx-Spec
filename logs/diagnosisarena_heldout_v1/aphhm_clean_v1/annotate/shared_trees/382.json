{
  "state": {
    "case_id": "382",
    "case_summary": "A man in his 40s presented with a 10-year history of pruritic lesions on the scrotum and buttock. He was previously treated at a local clinic with little improvement. He had no relevant medical history and no family history of similar skin problems.\n\nScattered, well-defined, annular gray hyperkeratotic plaques with an atrophic center and a slightly elevated edge on the scrotum, buttock, groin, and intergluteal cleft. There was no inguinal adenopathy.\n\n{'Laboratory Tests': 'Routine blood work, including blood biochemistry, syphilis serologies, and HIV testing, were normal or negative.', 'Histopathological Examination': {'Specimens': 'Two specimens taken from the scrotum and buttock', 'Findings': 'Revealed hyperkeratosis, irregular papillomatosis, parakeratotic columns (cornoid lamella) overlying dyskeratotic keratinocytes, and hypogranulosis with a perivascular infiltration of lymphocytes in the dermis', 'Images': {'Figure 1A': 'Clinical photograph showing scattered, well-defined, annular gray hyperkeratotic plaques with an atrophic center with a slightly elevated edge on the scrotum, buttock, groin, and intergluteal cleft', 'Figure 1B': 'Biopsy findings showing hyperkeratosis, irregular papillomatosis, parakeratotic column (cornoid lamella), and several dyskeratotic keratinocytes in the epidermal invagination with hypogranulosis and perivascular infiltration of lymphocytes in the dermis (hematoxylin-eosin)'}}}",
    "root": {
      "label": "Chronic Progressive Multifocal Skin Lesions with Pruritus and Dyskeratotic Features",
      "time_course": "chronic",
      "severity": "unspecified",
      "confidence": 0.8,
      "supporting_facts": [
        "10-year history of pruritic lesions",
