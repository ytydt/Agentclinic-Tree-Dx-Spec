{
  "state": {
    "case_id": "330",
    "case_summary": "A patient in their 80s with a history of hypertension controlled with Dyazide presented with 1 episode of syncope. The patient reported feeling hot and light-headed, felt they should lie down but suddenly awoke on the floor with considerable head and left shoulder pain. The patient also had a few near-fainting spells in the week prior to this index syncopal event.\n\nVital signs were stable without considerable orthostatic changes in blood pressure and heart rate.\n\n- Laboratory tests: Serum electrolyte levels and cardiac enzymes were normal.- Imaging studies:  - Cranial CT: No acute pathologic changes  - Echocardiogram: Mild concentric left ventricular hypertrophy with preserved left ventricular systolic function  - ECG findings:  First ECG (on admission):  - Sinus rhythm with right bundle-branch block   - Left anterior fascicular block  - PR interval of 204 milliseconds  - Premature atrial complex at rate of 64 beats per minute  - QRS axis deviation to -72°    Second ECG (following day):  - Sinus rhythm with right bundle-branch block  - Left posterior fascicular block   - PR interval of 210 milliseconds  - Rate of 58 beats per minute  - QRS axis deviation to +124°",
    "root": {
      "label": "Acute Syncope of Uncertain Aetiology with Uncharacterised ECG Abnormality and Left Ventricular Hypertrophy",
      "time_course": "acute",
      "severity": "unspecified",
      "confidence": 0.7,
      "supporting_facts": [
        "Episode of syncope",
        "Near-fainting spells in the week prior to the index syncopal event",
        "Stable vital signs without considerable orthostatic changes in blood pressure and heart rate",
        "Normal serum electrolyte levels and cardiac enzymes",
        "Mild concentric left ventricular hypertrophy with preserved left ventricular systolic function on echocardiogram",
        "Abnormal ECG findings including right bundle-branch block and fascicular block"
      ],
      "excluded_candidates": [
        "Cardiac arrhythmia: although the ECG shows abnormalities, the clinical presentation and other test results do not strongly suggest arrhythmia as the primary cause",
        "Orthostatic hypotension: the patient's vital signs were stable without considerable orthostatic changes in blood pressure and heart rate",
        "Seizure disorder: there is no clear evidence of seizure activity, and the patient's presentation is more consistent with a syncopal event"
      ],
      "alarm_features": [
        "History of hypertension",
        "Episode of syncope",
        "Near-fainting spells"
      ],
