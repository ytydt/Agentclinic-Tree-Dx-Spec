      "danger": 0.75,
      "askable_discriminators": [
        "Any history of early satiety, left upper quadrant pain, or known splenomegaly?"
      ],
      "requestable_discriminators": [
        "JAK2, CALR, or MPL mutation testing",
        "Peripheral blood smear for teardrop cells",
        "Imaging for splenomegaly"
      ],
      "turn_cost_to_refine": 1.0,
      "diagnosis_commitment_gain": 0.6,
      "interrupt_relevance": 0.7,
      "why_included": "Primary myelofibrosis can present with cytopenias, constitutional symptoms, and extramedullary hematopoiesis. While blast counts >20% suggest transformation to acute leukemia (blast phase), the absence of prior diagnosis makes this a consideration. Distinguishing de novo AML from post-MF AML affects prognosis and transplant eligibility."
    },
