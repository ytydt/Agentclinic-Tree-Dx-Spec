      "status": "live",
      "prior_estimate": 0.005,
      "danger": 0.6,
      "askable_discriminators": [
        "History of thrombosis or hemorrhage? Platelet count previously elevated?"
      ],
      "requestable_discriminators": [
        "JAK2 V617F, CALR, MPL mutation testing",
        "Peripheral blood smear for giant platelets"
      ],
      "turn_cost_to_refine": 1.0,
      "diagnosis_commitment_gain": 0.4,
      "interrupt_relevance": 0.5,
      "why_included": "ET presents with isolated thrombocytosis and is not consistent with current blast elevation. However, like other MPNs, it can undergo blast transformation. Its likelihood is very low here, but it must be included to maintain exhaustive coverage of the chronic myeloproliferative neoplasm family."
    }
  ],
  "sub_frontier": ["B3.1", "B3.2", "B3.3", "B3.4"],
  "need_external_knowledge": false,
  "knowledge_query_if_needed": ""
}
