vided)"], "alarm_features": ["Weight loss", "Hypercalcemia", "Elevated alkaline phosphatase"]}, "branches": {"B1": {"id": "B1", "label": "Malignancy with Hypercalcemia", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.881662640003545, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Serum calcium >12 mg/dL is more typical of malignancy (B1) than antacid overuse (B3). B1 gains moderate_for status; B3 and B4 are moderately disfavored."], "evidence_against": ["No single finding definitively contradicts malignancy. Mildly reduced evidence for B1 but no major disconfirming features."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "etiology", "representative_diseases": ["humoral hypercalcemia of malignancy", "multiple myeloma", "squamous cell carcinoma", "primary hyperparathyroidism"]}, "B2": {"id": "B2", "label": "Endocrine Disorder with Hypercalcemia", "level": 1, "status": "closed_for_now", "posterior": 0.022, "danger": 0.6, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Lack of PTH testing reduces confidence in B2. B1 remains better supported by constitutional symptoms and hypercalcemia severity."]}, "B3": {"id": "B3", "label": "Medication Overuse (Antacid-related)", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.17857142857142855, "posterior": 0.08171440289625616, "danger": 0.3, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": ["Serum calcium >12 mg/dL is more typical of malignancy (B1) than antacid overuse (B3). B1 gains moderate_for status; B3 and B4 are moderately disfavored."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.5, "interrupt_relevance": 0.4, "level_role": "family", "classification_axis": "management_pathway", "representative_diseases": []}, "B4": {"id": "B4", "label": "Other Systemic Inflammatory Conditions", "level": 1, "status": "closed_for_now", "posterior": 0.015, "danger": 0.5, "parent": "ROOT", "closure_reason": "", "evidence_against": ["No findings of granulomatous disease (e.g., sarcoidosis) reduce B4's plausibility. B1 remains the leading hypothesis."]}, "B1.1": {"id": "B1.1", "label": "Hematologic Malignancy (e.g., Multiple Myeloma)", "parent": "B1", "level": 2, "status": "live", "prior": 0.3918500622237978, "posterior": 0.3918500622237978, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.85, "level_role": "family", "classification_axis": "etiology", "representative_diseases": []}, "B1.2": {"id": "B1.2", "label": "Solid Tumor with Bone Metastases (e.g., Breast/Prostate Carcinoma)", "parent": "B1", "level": 2, "status": "live", "prior": 0.29388754666784833, "posterior": 0.29388754666784833, "danger": 0.75, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.65, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B1.3": {"id": "B1.3", "label": "Paraneoplastic Hypercalcemia from Non-Hematologic Cancers (e.g., Squamous Cell Carcinoma)", "parent": "B1", "level": 2, "status": "live", "prior": 0.1959250311118989, "posterior": 0.1959250311118989, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": 