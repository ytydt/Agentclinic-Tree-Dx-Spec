: Normal differential patterns suggest reactive leukocytosis rather than myeloproliferative disorder", "Diabetic Ketoacidosis: Glucose 120 mg/dL is within acceptable range for diabetes", "Acute Appendicitis: Normal physical exam and liver enzymes reduce likelihood", "Vascular Ischemia: Mild systolic murmur without other cardiac signs"], "alarm_features": ["Unintentional weight loss", "Marked leukocytosis", "Elevated alkaline phosphatase", "Hypercalcemia with systemic symptoms"]}, "branches": {"B1": {"id": "B1", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.0, "posterior": 0.0, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.0, "interrupt_relevance": 0.6, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute myeloid leukemia", "myelodysplastic syndrome with excess blasts", "chronic myeloid leukemia in blast crisis"]}, "B2": {"id": "B2", "label": "Lymphoid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.0, "posterior": 0.0, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.0, "interrupt_relevance": 0.5, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute lymphoblastic leukemia", "lymphoblastic lymphoma"]}, "B3": {"id": "B3", "label": "Chronic Myeloproliferative Neoplasm", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.5714023592563305, "posterior": 0.5714023592563305, "danger": 0.5, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidenc