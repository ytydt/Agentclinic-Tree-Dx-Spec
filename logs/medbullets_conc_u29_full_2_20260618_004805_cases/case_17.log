      "interrupt_relevance": 0.2,
      "why_included": "Leukemoid reaction (e.g., severe infection, inflammation) can mimic blasts but typically shows reactive morphology. Low priority given blast count ≥20%."
    }
  ],
  "frontier": ["B1", "B2", "B3"],
  "need_external_knowledge": false,
