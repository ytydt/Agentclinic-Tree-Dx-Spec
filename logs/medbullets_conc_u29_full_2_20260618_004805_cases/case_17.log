      "askable_discriminators": ["History of acute infection or inflammatory process?", "Are blasts morphologically dysplastic vs reactive?"],
      "requestable_discriminators": ["Peripheral blood smear for blast morphology", "Infectious workup (e.g., blood cultures)"],
      "turn_cost_to_refine": 1.5,
