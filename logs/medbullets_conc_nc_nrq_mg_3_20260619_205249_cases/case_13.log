el": 1, "status": "expanded", "prior": 0.4482758620689656, "posterior": 0.3196721311475411, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The prominent painful rash with papules/plaques weakly suggests primary dermatologic disorders rather than reactive hyperglycemia, which usually lacks skin man…"], "evidence_against": [], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "etiology", "representative_diseases": []}, "B2": {"id": "B2", "label": "Autoimmune / Metabolic Syndrome with Hyperglycemia", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.32183908045977, "posterior": 0.22950819672131142, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Obesity weakly supports metabolic syndromes, but the prominent painful rash weakly argues against reactive hyperglycemia mechanisms."], "evidence_against": ["Painful rash moderately conflicts with B2's typical non-painful dermatologic features."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 3.0, "diagnosis_commitment_gain": 0.3, "interrupt_relevance": 0.5, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B3": {"id": "B3", "label": "Reactive Hyperglycemia with Dermatologic Features", "level": 1, "status": "closed_for_now", "posterior": 0.033, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The extreme glucose level moderately conflicts with B3's expected milder elevations from stress/inflammation."]}, "B4": {"id": "B4", "label": "Inflammatory / Autoimmune Skin Disorders with Systemic Features", "parent": "ROOT", "level": 1, "status": "reopened", "prior": 0.13793103448275862, "posterior": 0.09836065573770493, "danger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["The prominent painful rash with papules/plaques weakly suggests primary dermatologic disorders rather than reactive hyperglycemia, which usually lacks skin man…"], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 3.5, "diagnosis_commitment_gain": 0.2, "interrupt_relevance": 0.3, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B1.1": {"id": "B1.1", "label": "Glucagonoma (Alpha Cell Tumor)", "parent": "B1", "level": 2, "status": "live", "prior": 0.20376175548589345, "posterior": 0.14530551415797321, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": ["The absence of migratory necrolytic erythema in a hyperglycemic patient strongly reduces glucagonoma likelihood."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.3, "interrupt_relevance": 0.9, "level_role": "specific_disease", "classification_axis": "mechanism", "representative_diseases": []}, "B1.2": {"id": "B1.2", "label": "Adrenal Cortical Tumor with Hypercortisolism (Cushing's Syndrome)", "parent": "B1", "level": 2, "status": "live", "prior": 0.15282131661442008, "posterior": 0.10897913561847991, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Chronic glucose elevation in Cushing's syndrome is weakly consistent with this patient's subacute presentation, though the painful rash remains unexplained."], "evidence_against": ["The presence of a painful rash moderately conflicts with Cushing's typical non-painful skin findings."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.2, "diagnosis_commitment_gain": 0.25, "interrupt_relevance": 0.8, "level_role": "specific_disease",