on_type": "ANALYZE_VIGNETTE", "diagnosis_readiness_score": 0.22950819672131142, "benchmark_output_ready": false, "static_question": "Which of the following is the most likely underlying pathophysiology of this patient’s condition?", "static_options": [{"id": "A", "description": "Alpha cell tumor"}, {"id": "B", "description": "Beta cell destruction"}, {"id": "C", "description": "Beta cell tumor"}, {"id": "D", "description": "Hypercortisolism"}, {"id": "E", "description": "Insulin resistance"}], "seen_evidence_ids": [], "seen_evidence_phenotypes": "{'Hyperglycemia', 'erythema', 'Postprandial hyperglycemia', 'erythematous papule', 'erythematous papules'}", "mode_policy": {"benchmark_purity": true, "allow_external_knowledge": true}, "answer_option_mapping": {}, "tool_use_log": [], "root_revision_needed": false, "program_faults": [], "max_tree_depth": 3, "reasoning_ledger": {"anchor": {"hypothesis": "B1", "t": 0, "posterior_at_anchor": 0.448}, "leader": {"branch_id": "B2", "label": "Autoimmune / Metabolic Syndrome with Hyperglycemia", "posterior": 0.23, "leading_since_t": 0, "n_revisions": 0}, "leader_evidence": {"confirming": 3, "disconfirming": 3, "last_disconfirming_digest": "Painful rash moderately conflicts with B2's typical non-painful dermatologic features."}, "action_intents": [{"t": 2, "intent": "broaden"}, {"t": 2, "intent": "broaden"}, {"t": 2, "intent": "broaden"}, {"t": 2, "intent": "broaden"}, {"t": 2, "intent": "refute"}, {"t": 2, "intent": "broaden"}], "considered_alternatives": ["B1.1", "B1.2", "B4"]}, "discriminator_hints": "[Knowledge Layer: coverage=60%, source=both]\n\nAutoimmune / Metabolic Syndrome with Hyperglycemia vs Glucagonoma (Alpha Cell Tumor):\n  Favours first:  abnormal auditory evoked potentials, abnormal cerebellum morphology, abnormal cerebral white matter morphology, abnormal facial shape, abnormal foot morphology\n  Favours second: abnormal abdomen morphology, abnormal blistering of the skin, abnormal gastrointestinal motility, abnorm