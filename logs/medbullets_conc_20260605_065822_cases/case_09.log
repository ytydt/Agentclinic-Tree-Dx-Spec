        "Lymph node biopsy or bone marrow aspirate for tissue evaluation"
      ],
      "turn_cost_to_refine": 2.5,
      "diagnosis_commitment_gain": 0.4,
      "interrupt_relevance": 0.6,
      "why_included": "Covers CLL (option B) and multiple myeloma (option E) despite atypical presentation, as weight loss is a 'B symptom' for lymphoproliferative disorders."
    },
    {
      "id": "B3",
      "label": "Reactive / Non-malignant Leukocytosis",
      "status": "live",
      "prior_estimate": 0.25,
      "danger": 0.6,
      "level_role": "family",
      "classification_axis": "mechanism",
      "askable_discriminators": [
        "Are there signs/symptoms of an underlying infection or inflammation?",
        "Were there recent drug exposures (e.g., corticosteroids) or acute stressors?",
        "Does the patient have leukoerythroblastosis on blood smear?"
      ],
      "requestable_discriminators": [
        "Blood cultures and inflammatory markers (CRP, ESR)",
        "Cytopenia severity and response to hydration",
        "Repeat CBC after 1-week to assess for transient elevation"
      ],
      "turn_cost_to_refine": 1.5,
      "diagnosis_commitment_gain": 0.3,
      "interrupt_relevance": 0.4,
      "why_included": "Aligns with leukemoid reaction (option D) due to elevated LAP and normal differential; common in infections or reactive marrow expansion."
    },
    {
      "id": "B4",
      "label": "Myeloid Neoplasm with Increased Blasts",
      "status": "parked",
      "prior_estimate": 0.05,
      "danger": 0.95,
      "level_role": "family",
      "classification_axis": "urgency",
      "askable_discriminators": [
        "Are marrow fibrosis or blast cell clusters evident on imaging?",
        "Has the patient developed new symptoms of hyperleukocytosis (e.g., respiratory distress)?",
        "Does the leukocyte count correlate with blast percentage from smear?"
      ],
      "requestable_discriminators": ["Bone marrow biopsy for blast percentage", "Ph chromosome testing", "KIT D816V mutation analysis"],
      "turn_cost_to_refine": 3.0,
      "diagnosis_commitment_gain": 0.6,
      "interrupt_relevance": 0.2,
      "why_included": "Cannot be excluded yet despite normal differential; blasts may exist but be masked by technical factors during WBC processing."
    },
    {
      "id": "B5",
      "label": "Inflammatory / Autoimmune Condition",
      "status": "parked",
      "prior_estimate": 0.08,
      "danger": 0.4,
      "level_role": "family",
      "classification_axis": "etiology",
      "askable_discriminators": [
        "Are there features of autoimmune hemolytic anemia or other immune-mediated syndromes?",
        "Is hypogammaglobulinemia or paradoxical C-reactive protein elevation present?",
        "Is there a pattern of recurrent infections or other autoimmune organ involvement?"
      ],
      "requestable_discriminators": [
        "Autoantibody panel (ANA, ANCA, Coombs test)",
        "Inflammatory markers (CRP, sedimentation rate)",
        "Serum immunoglobulin levels"
      ],
      "turn_cost_to_refine": 2.0,
      "diagnosis_commitment_gain": 0.2,
      "interrupt_relevance": 0.1,
      "why_included": "Low-prior but possible mechanism requiring evaluation before finalizing haematologic vs immunologic aetiology."
    }
  ],
  "frontier": ["B1", "B2", "B3"],
  "need_external_knowledge": false,
  "knowledge_query_if_needed": ""
}
