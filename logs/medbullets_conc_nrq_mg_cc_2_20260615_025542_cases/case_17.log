lic decompensation from diabetes: Normal serum chemistry with normal glucose and electrolytes", "Neurodegenerative disorder: Ataxia with otherwise nonfocal exam, but lacks chronic progressive pattern", "Autoimmune vasculitis: Constitutional symptoms with neurological deficits, but lacks typical immunological markers"], "alarm_features": ["Constitutional B symptoms (weight loss, fever, night sweats)", "Hematological abnormalities with blasts", "Acute neurological deterioration (visual acuity decline, ataxia)"]}, "branches": {"B1": {"id": "B1", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.5500848896434634, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Lymphoid blast disorders typically present with lymphadenopathy; absence weakly disfavors B2 but supports B1 and B3 for myeloid/chronic phases."], "evidence_against": ["Absence of bone marrow infiltration signs weakly disfavors myeloid neoplasms (B1) but is neutral for B3 and B4 due to incomplete evidence."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute myeloid leukemia", "myelodysplastic syndrome with excess blasts", "chronic myeloid leukemia in blast crisis"]}, "B2": {"id": "B2", "label": "Lymphoid Neoplasm with Increased Blasts", "level": 1, "status": "parked", "posterior": 0.146, "danger": 0.85, "parent": "ROOT", "closure_reason": "", "evidence_against": ["High leukocyte count with blasts is more consistent with chronic neoplasm transformation (B3), but evidence is limited; weakly supports B3 and moderately disfa…"]}, "B3": {"id": "B3", "label": "Chronic Myeloproliferative Neoplasm (chronic/accelerated phase)", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.20373514431239384, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["High leukocyte count with blasts is more consistent with chronic neoplasm transformation (B3), but evidence is limited; weakly supports B3 and moderately disfa…"], "evidence_against": ["Lymphoid blast disorders typically present with lymphadenopathy; absence weakly disfavors B2 but supports B1 and B3 for myeloid/chronic phases."], "unresolved_questions": [], "children": ["B3.1", "B3.2", "B3.3", "B3.4"], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.65, "interrupt_relevance": 0.5, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["chronic myeloid leukemia", "polycythemia vera", "essential thrombocythemia", "primary myelofibrosis"]}, "B4": {"id": "B4", "label": "Lymphoproliferative / Plasma Cell Disorder", "level": 1, "status": "parked", "posterior": 0.062, "danger": 0.4, "parent": "ROOT", "closure_reason": "", "evidence_against": ["High leukocyte count with blasts is more consistent with chronic neoplasm transformation (B3), but evidence is limited; weakly supports B3 and moderately disfa…"]}, "B5": {"id": "B5", "label": "Reactive / Non-malignant Leukocytosis", "level": 1, "status": "parked", "posterior": 0.039, "danger": 0.2, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B1.1": {"id": "B1.1", "label": "De Novo Acute Myeloid Leukemia (AML)", "parent": "B1", "level": 2, "status": "live", "prior": 0.350054020682204, "posterior": 0.350054020682204, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.2, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.9, "level_role": "disease_class", "classification_axis": "etiology", "representative_disea