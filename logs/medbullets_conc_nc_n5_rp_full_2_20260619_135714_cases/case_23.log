      "invasiveness": 0.0,
      "target_branches": {"B1": "support", "B2": "against"},
      "primary_function": "confirm",
      "bundle_independence": 1.0,
      "result_dependency": false,
      "redundancy_group": "",
      "urgency": "routine",
      "why": "one-line rationale"
    }
  ]
}
