        "content": "No history of connective tissue disease",
        "id": "E8",
        "independent": true,
        "kind": "direct",
        "metadata": {
          "extractor": "diagnosisarena_vignette_parser_freeze_v2"
        },
        "source_ids": []
      },
      {
