      {
        "branch_links": {},
        "content": "Chief complaint: asymptomatic, arc-shaped, depressed skin groove on the left side of the forehead, frontal scalp, and vertex area",
        "id": "E2",
        "independent": true,
        "kind": "direct",
        "metadata": {
          "extractor": "diagnosisarena_vignette_parser_freeze_v2"
        },
        "source_ids": []
      },
      {
        "branch_links": {},
        "content": "Localized linear hair loss and hair thinning on the left scalp area",
        "id": "E3",
        "independent": true,
        "kind": "direct",
        "metadata": {
          "extractor": "diagnosisarena_vignette_parser_freeze_v2"
        },
        "source_ids": []
      },
      {
        "branch_links": {},
        "content": "Lesion began approximately 10 years earlier",
        "id": "E4",
        "independent": true,
        "kind": "direct",
        "metadata": {
          "extractor": "diagnosisarena_vignette_parser_freeze_v2"
        },
        "source_ids": []
      },
      {
        "branch_links": {},
        "content": "Received 2 doses of intralesional steroid via injection on a small bald patch on the vertex",
        "id": "E5",
        "independent": true,
        "kind": "direct",
        "metadata": {
          "extractor": "diagnosisarena_vignette_parser_freeze_v2"
        },
        "source_ids": []
      },
      {
        "branch_links": {},
        "content": "Lesion gradually progressed to the frontal scalp and eventually made a linear furrow on the left side of his forehead",
        "id": "E6",
        "independent": true,
        "kind": "direct",
        "metadata": {
          "extractor": "diagnosisarena_vignette_parser_freeze_v2"
        },
        "source_ids": []
      },
      {
        "branch_links": {},
        "content": "Denied any trauma history",
        "id": "E7",
        "independent": true,
        "kind": "direct",
        "metadata": {
          "extractor": "diagnosisarena_vignette_parser_freeze_v2"
        },
        "source_ids": []
      },
      {
