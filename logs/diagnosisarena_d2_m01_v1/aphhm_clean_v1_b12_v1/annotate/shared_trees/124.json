{
  "state": {
    "case_id": "124",
    "case_summary": "A woman in her 60s presented with a slowly growing subcutaneous node in the right axilla that she first noticed 10 years ago, with progressive infiltration of the overlying skin over the past year. She reported experiencing swelling in the right axilla during pregnancy over 20 years ago that disappeared with lactation, followed by mild episodic pain in her right axilla during menstrual cycles.\n\nSolitary, indolent, erythematous plaque in the right axilla measuring 5 × 3 cm\n\n{'Histopathology': {'Punch Biopsy': \"Dermal tumor infiltrating the subcutaneous fat without epidermal involvement. Tumor cells diffusely dispersed between collagen bundles and lined up in an 'Indian file pattern' with basophilic nuclei and scant cytoplasm.\", 'Immunohistochemistry': 'Positive for: pancytokeratin (AE1/AE3), cytokeratin 20, GCDFP15, estrogen receptor, and GATA3 antibodies. Negative for: synaptophysin, chromogranin, and S100-stainings.', 'Excision Findings': 'Multiple GATA3-positive and estrogen receptor–positive apocrine glands in close association to diffuse tumor cell infiltration', 'Lymph Node Analysis': '1 of the sentinel lymph nodes showed isolated cytokeratin8/18–positive tumor cells and MNF116-positive tumor cells'}, 'Imaging Studies': {'Staging': 'Chest, abdominal, and pelvic CT scans, cranial and breast MRI, mammography, and breast sonography revealed no evidence of primary or secondary tumors', 'Images': {'Figure A': 'Clinical photograph shows erythematous plaque in the right axilla measuring about 5 × 3 cm', 'Figure B': 'Histopathology from skin punch biopsy showing dense dermal infiltrates of atypical epithelioid tumor cells with basophilic nuclei dispersed between collagen fibers in an Indian file pattern', 'Figure C': 'Histopathology from complete tumor excision showing closely associated apocrine glands apart from diffuse infiltrates of tumor cells', 'Figure D': 'Immunohistochemistry demonstrating GATA3-positive apocrine glandular structures'}}}",
    "root": {
      "label": "Chronic Progressive Subcutaneous Axillary Mass with Epidermal Involvement and Possible Adnexal Differentiation",
      "time_course": "chronic",
      "severity": "unspecified",
      "confidence": 0.8,
      "supporting_facts": [
        "slowly growing subcutaneous node in the right axilla",
        "progressive infiltration of the overlying skin",
        "solitary, indolent, erythematous plaque in the right axilla",
        "dermal tumor infiltrating the subcutaneous fat without epidermal involvement",
        "positive immunohistochemistry for pancytokeratin, cytokeratin 20, GCDFP15, estrogen receptor, and GATA3"
      ],
      "excluded_candidates": [
