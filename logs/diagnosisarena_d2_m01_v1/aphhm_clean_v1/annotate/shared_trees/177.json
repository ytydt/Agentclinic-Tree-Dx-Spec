{
  "state": {
    "case_id": "177",
    "case_summary": "An older woman with a history of diabetes and paroxysmal atrial fibrillation presented with sudden-onset chest pain. One hour later, the intensity of pain had increased.\n\nVital signs showed a normal heart rate and blood pressure initially. Later, her blood pressure fell to 60/40 mm Hg without arrhythmia or bleeding.\n\n- ECG findings:    At presentation: Normal sinus rhythm, up to 2.0-mm ST-segment elevation in leads II, III, and aVF, subtle ST-segment elevation in leads V7-V9, and 1.0-mm to 2.0-mm downward-sloping ST-segment depression in leads V2-V4. R/S greater than 1 in leads V1-V2.    One hour later: New ST-segment elevation in V5-6 and higher ST-segment elevation in inferior and posterior leads. No pathologic Q waves.  - Laboratory tests:    Initial high-sensitive troponin T level: 0.309 ng/mL (reference range, 0.00-0.03 ng/mL)  - Imaging studies:    1. Emergency angiography showed thrombotic occlusion of the distal left circumflex artery    2. Computer tomography angiography revealed contrast present in the myocardium and pericardial effusion",
    "root": {
      "label": "Acute Chest Pain Syndrome with Suggestive Myocardial Infarction and Haemodynamic Instability",
      "time_course": "acute",
      "severity": "unspecified",
      "confidence": 0.9,
      "supporting_facts": [
        "sudden-onset chest pain",
        "ST-segment elevation in multiple ECG leads",
        "elevated high-sensitive troponin T level",
        "thrombotic occlusion of the distal left circumflex artery on emergency angiography"
      ],
      "excluded_candidates": [
        "Pulmonary Embolism: less likely due to the presence of ST-segment elevation and thrombotic occlusion of the left circumflex artery",
        "Aortic Dissection: less likely due to the lack of suggestive symptoms such as severe back pain or unequal blood pressures in the arms"
      ],
      "alarm_features": [
        "hypotension with blood pressure 60/40 mm Hg",
        "elevated troponin level indicating myocardial infarction"
      ],
      "salient_findings": [
        "ST-segment elevation in leads II, III, and aVF",
        "downward-sloping ST-segment depression in leads V2-V4",
        "elevated troponin level of 0.309 ng/mL",
        "thrombotic occlusion of the distal left circumflex artery",
        "pericardial effusion on computer tomography angiography"
      ]
    },
