  "1066195b59e86c7b400782abc6248290dd8297928601a52f46d404ef4c36f33c": {
    "fact_rationales": {
      "F10": "Firm, red-brown plaques without overlying scale are consistent with several dermatological conditions, including eczema, atopic dermatitis, and scleromyxedema.",
      "F13": "Nodular proliferations of thick collagen fibers are more characteristic of scleromyxedema and eosinophilic fasciitis.",
      "F14": "Homogeneous, brightly eosinophilic collagen bundles in a haphazard array are more typical of scleromyxedema and can be seen in eosinophilic fasciitis.",
      "F3": "Systemic sclerosis is a known comorbidity with nephrogenic systemic fibrosis and can also be associated with scleromyxedema and eosinophilic fasciitis."
    },
