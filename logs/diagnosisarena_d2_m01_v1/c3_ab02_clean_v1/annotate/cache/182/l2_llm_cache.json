  "2c84c6e04a2cab36eaf03123833baefd36a65e627299d6d85a262e3e5895eaa7": {
    "fact_rationales": {
      "F11": "Mature adipose and fibrous tissues are characteristic of benign lipomatous tumors, which supports Lipoma, Fibrolipoma, and Angiolipoma, but not Primary Subcutaneous Ewing Sarcoma.",
      "F3": "A long duration since infancy is more typical of benign conditions, but not exclusive to them.",
      "F5": "The skin-colored, exophytic, soft, oval tumor is consistent with a benign lipomatous tumor, but less specific for Primary Subcutaneous Ewing Sarcoma.",
      "F6": "Pinpoint vessels and branching telangiectasia are more characteristic of Angiolipoma, which often contains vascular components."
    },
    "per_fact_effects": {
