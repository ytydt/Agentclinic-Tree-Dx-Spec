  "13424bb7387bd8a9183df4d2f114d11fcdca93bc3c752f734deedec15c6da664": {
    "fact_rationales": {
      "F10": "Changes in macular edema over the course of treatment can be seen in conditions like retinal vein occlusion and cystoid macular edema.",
      "F11": "The figure showing reversible effect on cystoid macular edema secondary to retinal vein occlusion after stopping niacin therapy suggests a strong link between these conditions.",
      "F8": "Severe macular changes with associated edema are more typical of retinal vein occlusion and cystoid macular edema.",
      "F9": "Persistent central macular thickness is a key feature of macular edema, which can be caused by retinal vein occlusion."
    },
