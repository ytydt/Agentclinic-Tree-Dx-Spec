  "e05cae52368178cf0966e39e4704870ec2c5e181a46364f582bdd60004f9ace9": {
    "fact_rationales": {
      "F10": "The presence of long, curved-line, depressed, alopecic patches is more typical of conditions like frontal fibrosing alopecia and lichen planopilaris.",
      "F17": "Predominant lymphocytic infiltrates in perifollicular and periappendageal regions of the dermis and lobular panniculitis are indicative of inflammatory conditions affecting the scalp.",
      "F19": "Positive direct immunofluorescence with granular deposition of IgG, IgA, IgM, C3, C1q, and fibrinogen in the dermal blood vessels is more characteristic of autoimmune conditions like Discoid Lupus Erythematosus.",
      "F3": "Localized linear hair loss and hair thinning are more typical of certain conditions like lichen planopilaris and frontal fibrosing alopecia."
    },
