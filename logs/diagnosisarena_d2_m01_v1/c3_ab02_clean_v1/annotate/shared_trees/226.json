{
  "state": {
    "case_id": "226",
    "case_summary": "A white woman in her early 40s presented with generalized pruritus of 10-years' duration. She had no other medical history. She had been treated with topical corticosteroids with no control of the symptoms.\n\nPhysical examination revealed erythematous papules, some of them crusted, and some excoriations located over the trunk and upper extremities. In addition, some scales and fissures were seen on her lower lip, sparing the surrounding skin, as well as inner mouth and upper lip.\n\n{'Laboratory Tests': 'Blood test results including antinuclear antibodies and complement, along with urine porphyrin analysis were normal.', 'Skin Biopsy': 'The biopsy results showed spongiosis and erosions in the epidermis and a nodular lymphocyte infiltrate in the upper and mid dermis with a peripheral mantle zone surrounding a central germinal center with cells that were CD20 positive and BCL-2 negative.', 'Phototest': 'Phototest with a solar simulator (Saalman Multitester TYP SBC LT 400) was carried out with the immediate reading negative for UV-B, UV-A, and visible light. However, erythema appeared in the area irradiated with UV-A 48 hours afterwards.', 'Images': {'Figure 1A': 'Clinical image showing unspecific erythematous papules on the arm', 'Figure 1B': 'Clinical image showing scales, crusts, and fissures on the lower lip', 'Figure 2A': 'Hematoxylin-eosin staining demonstrates spongiosis and erosions over the epidermis and a nodular infiltrate in the upper and mid dermis composed of lymphoid aggregates with ample germinal centers', 'Figure 2B': 'Higher magnification shows the germinal center and mantle of the lymphoid follicles in the dermis'}}",
    "root": {
      "label": "Chronic Progressive Pruritic Dermatosis with Erythematous Papules and Lymphoid Infiltrate",
      "time_course": "chronic",
      "severity": "unspecified",
      "confidence": 0.7,
      "supporting_facts": [
        "generalized pruritus of 10-years' duration",
        "erythematous papules and excoriations on the trunk and upper extremities",
        "scales and fissures on the lower lip",
        "spongiosis and erosions in the epidermis and a nodular lymphocyte infiltrate in the dermis"
      ],
      "excluded_candidates": [
        "Psoriasis: reason ranked lower due to absence of classic psoriatic lesions and lack of response to topical corticosteroids",
        "Atopic Dermatitis: reason ranked lower due to lack of personal or family history of atopy and absence of typical atopic dermatitis lesions"
      ],
      "alarm_features": [
        "chronic and persistent pruritus"
      ],
      "salient_findings": [
        "erythematous papules",
        "excoriations",
