es": {"B1": {"id": "B1", "label": "Primary Hyperparathyroidism (PTH-mediated)", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.697144441268176, "danger": 0.3, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The subacute course and constitutional symptoms (weight loss, GERD) are consistent with primary hyperparathyroidism, which often presents with gradual hypercal…"], "evidence_against": ["Normal phosphorus is atypical for PTH-mediated hypercalcemia (which usually causes hypophosphatemia), suggesting this mechanism is less likely while keeping ot…"], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.2, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B2": {"id": "B2", "label": "Malignancy-associated Hypercalcemia (PTHrP/osteolytic)", "level": 1, "status": "parked", "posterior": 0.051, "danger": 0.9, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Lack of bone pain and no mention of PTHrP reduces support for malignancy-associated hypercalcemia, though constitutional symptoms remain concerning."]}, "B3": {"id": "B3", "label": "Vitamin D/Granulomatous Hypercalcemia", "level": 1, "status": "parked", "posterior": 0.131, "danger": 0.5, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Low phosphorus is inconsistent with vitamin D/granulomatous hypercalcemia (which typically causes hyperphosphatemia), providing moderate evidence against this …"]}, "B4": {"id": "B4", "label": "Other Hypercalcemic Disorders (Drug/Endocrine/Immobilization)", "level": 1, "status": "parked", "posterior": 0.12, "danger": 0.4, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Classic milk-alkali syndrome requires calcium/vitamin D excess, not just antacids. Absence of thiazides/immobilization provides weak evidence aga