 "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.5, "level_role": "disease_class", "classification_axis": "mechanism"}, "B1.3": {"id": "B1.3", "label": "Meconium Ileus", "parent": "B1", "level": 2, "status": "live", "prior": 0.05876951331496787, "posterior": 0.05876951331496787, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the abdominal radiograph show distal gas 'ground-glass' pattern or 'beaver-tail' appearance?", "Was meconium delayed passage (<24h) reported in the vignette?"], "requestable_discriminators": ["Newborn screening for cystic fibrosis if not already completed", "Abdominal ultrasound to demonstrate hyperplastic distal ileum"], "turn_cost_to_refine": 3.0, "diagnosis_commitment_gain": 0.5, "interrupt_relevance": 0.4, "level_role": "disease_class", "classification_axis": "etiology"}, "B1.4": {"id": "B1.4", "label": "Pyloric Stenosis (Early Presentation Variant)", "parent": "B1", "level": 2, "status": "live", "prior": 0.029384756657483933, "posterior": 0.029384756657483933, "danger": 0.3, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Is there peristaltic waves observed in the epigastrium?", "Has the patient developed progressive non-bilious projectile vomiting?"], "requestable_discriminators": ["Upper GI contrast study to confirm 'string sign' in duodenum (not pyloric)", "Abdominal ultrasound for pyloric hypertrophy (typically delayed presentation after 3 weeks)"], "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.2, "level_role": "disease_class", "classification_axis": "anatomy"}, "B2.1": {"id