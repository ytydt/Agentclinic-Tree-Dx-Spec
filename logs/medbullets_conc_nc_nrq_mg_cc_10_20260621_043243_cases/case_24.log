er"]}, "branches": {"B1": {"id": "B1", "label": "Bacterial Superinfection of Sinusitis", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.661764705882353, "danger": 0.3, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The presence of systemic signs (hypotension/tachycardia) and purulent discharge favors bacterial superinfection over viral progression, with moderate clinical …"], "evidence_against": ["Absence of skin findings and normal imaging weakly contradicts bacterial superinfection (B1) but has minimal impact on other branches."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.2, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B2": {"id": "B2", "label": "Foreign Body with Secondary Infection", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.115, "posterior": 0.19025735294117652, "danger": 0.1, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Unilateral discharge supports foreign body obstruction (B2) but is weakened by the lack of object insertion history, providing moderate but not strong evidence."], "evidence_against": ["Systemic signs like hypotension and fever are less typical of foreign body obstruction (B2), providing weak contradiction."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.1, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B3": {"id": "B3", "label": "Structural Abnormality with Secondary Infection", "level": 1, "status": "parked", "posterior": 0.063, "danger": 0.1, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Unilateral discharge supports foreign body obstruction (B2) but is weakened by the lack of object insertion history, providing moderate but not strong evidence."]}, "B4": {"id": "B4", "label": "Local Vascular Infection or Trauma", "level": 1, "status": "parked", "posterior": 0.063, "danger": 0.05, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Unilateral discharge supports foreign body obstruction (B2) but is weakened by the lack of object insertion history, providing moderate but not strong evidence."]}, "B5": {"id": "B5", "label": "Systemic Infection with Hemodynamic Instability", "level": 1, "status": "closed_for_now", "posterior": 0.021, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Low-grade fever and normal exam weakly contradict systemic infection (B5) as the primary cause of instability."]}, "B1.1": {"id": "B1.1", "label": "Streptococcus pneumoniae/typical bacterial superinfection", "parent": "B1", "level": 2, "status": "live", "prior": 0.3308823529411765, "posterior": 0.3308823529411765, "danger": 0.3, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.1, "level_role": "specific_disease", "classification_axis": "etiology", "representative_diseases": []}, "B1.2": {"id": "B1.2", "label": "MRSA superinfection in community-acquired sinusitis", "parent": "B1", "level": 2, "status": "live", "prior": 0.1985294117647059, "posterior": 0.1985294117647059, "danger": 0.4, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.5, "interrupt_relevance": 0.2, "level_role": "specific_disease", "classification_axis": "etiology", "representative_diseases": []}, "B1.3": {"id": "B1.3", "label": "Pseudomonas 