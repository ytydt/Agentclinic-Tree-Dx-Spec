): requires further imaging to confirm localization but remains a high-risk differential due to constitutional symptoms"], "alarm_features": ["Unintentional weight loss", "Smoking history", "Hypertension", "Elevated temperature"]}, "branches": {"B1": {"id": "B1", "label": "Thoracic Neoplasm with Neurological Involvement", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.6673447820343459, "posterior": 0.6673447820343459, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.95, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B2": {"id": "B2", "label": "Brachial Plexopathy", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.23896961690885068, "posterior": 0.23896961690885068, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.4, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B3": {"id": "B3", "label": "Neurovascular Compression Syndrome", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.25667107001320993, "posterior": 0.25667107001320993, "danger": 0.3, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.3, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B4": {"id": "B4", "label": "Cerebrovascular Disease with Subacute Presentation", "parent