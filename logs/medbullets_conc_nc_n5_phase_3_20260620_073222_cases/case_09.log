ore": 0.5, "evidence_for": [], "evidence_against": ["CML classically causes splenomegaly, but early-phase CML may not. The absence of splenomegaly weakly reduces CML's likelihood (B3) without strongly excluding i…"], "unresolved_questions": [], "children": ["B3.1", "B3.2", "B3.3", "B3.4"], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.6, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["chronic myeloid leukemia", "polycythemia vera", "essential thrombocythemia", "primary myelofibrosis"]}, "B4": {"id": "B4", "label": "Plasma Cell Disorder (e.g., Multiple Myeloma)", "level": 1, "status": "closed_for_now", "posterior": 0.006, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Elevated platelets are atypical for multiple myeloma, which often causes thrombocytopenia. This weakly reduces B4's likelihood."]}, "B5": {"id": "B5", "label": "Reactive / Non-malignant Leukocytosis", "level": 1, "status": "parked", "posterior": 0.139, "danger": 0.5, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B3.1": {"id": "B3.1", "label": "Polycythemia Vera", "parent": "B3", "level": 2, "status": "live", "prior": 0.10508110876288083, "posterior": 0.1323618449310283, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Elevated LAP weakly supports polycythemia vera (B3.1) as a possible myeloproliferative neoplasm despite normal hemoglobin/hematocrit."], "evidence_against": ["The absence of erythrocytosis weakly disfavors polycythemia vera (B3.1) despite elevated LAP, which is more typical of PV."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.4, "level_role": "specific_disease", "classification_axis": "etiology", "representative_diseases": []}, "B3.2": {"id": "B3.2", "label": "Chronic Myeloid