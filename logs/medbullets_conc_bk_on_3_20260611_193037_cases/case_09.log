d_candidates": ["Chronic myeloid leukemia (CML): elevated LAP strongly argues against CML as primary aetiology", "Primary hyperparathyroidism: hypercalcemia without parathyroid-specific signs (e.g., renal stones, bone pain)", "Acute infectious etiology: normal differential and resolved cold reduce likelihood of reactive leukocytosis", "Malignant visceral mass syndrome: hypercalcemia and leukocytosis could reflect tumor burden but lacks direct evidence"], "alarm_features": ["Unintentional weight loss", "Hypercalcemia with serum calcium >10.5 mEq/L", "Marked leukocytosis with elevated LAP", "Mild fever (37.5°C) and hypertension (150/100 mmHg)"]}, "branches": {"B1": {"id": "B1", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.002658136242068278, "posterior": 0.002658136242068278, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.75, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute myeloid leukemia", "myelodysplastic syndrome with excess blasts", "chronic myeloid leukemia in blast crisis"]}, "B2": {"id": "B2", "label": "Lymphoid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.07682416487492787, "posterior": 0.07682416487492787, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.6, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute lymphoblastic leukemia", "lymphoblastic lymphoma"]}, "B3": {"id": "B3", "label": "Chronic 