o exclude pregnancy-related emergencies"], "excluded_candidates": ["Appendicitis: low-tier given RUQ localization rather than RIF tenderness", "Exertional heat-related disorder: improbable due to hypotension and absence of hyperthermia", "Inflammatory bowel disease: lacks characteristic symptoms for acute presentation", "Metabolic disturbance from OCP-agranulocytosis interaction: plausible but indirect mechanism", "Anaphylactic reaction: lacks skin findings typical of anaphylaxis despite acne"], "alarm_features": ["Shock-like vital signs (hypotension with tachycardia, 80/40 mmHg and 110 bpm)", "Chronic heavy alcohol consumption (≥5 drinks/day)"]}, "branches": {"B1": {"id": "B1", "label": "Gynecological Emergencies Including Pregnancy-Related Pathologies", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.3559322033898305, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Unprotected sexual activity (E8) and β-hCG testing (E27) raise suspicion for ectopic pregnancy (A) among reproductive-age females with acute RUQ pain and shock."], "evidence_against": [], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of recent amenorrhea increasing suspicion of gynecological pathology?", "History of unprotected sexual activity increasing reproductive risk?"], "requestable_discriminators": ["Urinary ß-hCG", "Pelvic ultrasound findings", "Human chorionic gonadotropin (hCG) levels"], "turn_cost_to_refine": 1.2, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.85, "level_role": "family", "classification_axis": "anatomy"}, "B2": {"id": "B2", "label": "Biliary Tract Emergencies with Shock-Like Presentation", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.45, "posterior": 0.45762711864406785, "danger": 0.95, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evid