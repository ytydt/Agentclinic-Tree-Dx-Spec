nger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": [], "evidence_against": ["The absence of peritoneal signs (e.g., guarding, rebound tenderness) or a clear imaging-based transition point weakens the mechanical obstruction hypothesis, but insufficiently to decisively exclude it."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Are there dilated loops of bowel or transition points visible on imaging?", "Was there recent ingestion of foreign material or food intolerance?"], "requestable_discriminators": ["Abdominal CT scan with oral contrast", "Plain abdominal radiograph review for air-fluid levels"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.75, "interrupt_relevance": 0.3, "level_role": "family", "classification_axis": "anatomy"}, "B2": {"id": "B2", "label": "Paralytic Bowel Obstruction", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.07911868613714163, "posterior": 0.08572335514571885, "danger": 0.1, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": [], "evidence_against": ["The absence of documented electrolyte abnormalities (e.g., E5 states the patient is otherwise healthy) strongly undermines the plausibility of paralytic ileus, which is often secondary to metabolic or postoperative causes.", "Paralytic obstruction is typically associated with post-surgical bowel rest or other systemic risk factors (e.g., chronic constipation), neither of which are present here. This finding moderately weakens the possibility."], "unresolved_questions": [], "children": ["B2.1", "B2.2"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the patient have recent abdominal surgery or electrolyte disturbances?", "Is there generalized peristalsis suppression on imaging?"], "requestable_discriminators": ["Urgent plain abdominal X-ray", "Serum electro