ition", "level": 1, "status": "closed_for_now", "posterior": 0.049365694133623406, "danger": 0.5, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Progressive dilation would suggest structural rather than congenital causes, but stable findings maintain diagnostic uncertainty."]}, "B4": {"id": "B4", "label": "Primary Immunodeficiency with Recurrent Pulmonary Symptoms", "level": 1, "status": "parked", "posterior": 0.05055047079283038, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Progressive dilation would suggest structural rather than congenital causes, but stable findings maintain diagnostic uncertainty."]}, "B5": {"id": "B5", "label": "Reactive / Non-Malignant Inflammatory Sinus and Airway Condition", "level": 1, "status": "closed_for_now", "posterior": 0.032910462755748944, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Progressive dilation would suggest structural rather than congenital causes, but stable findings maintain diagnostic uncertainty."]}, "B1.1": {"id": "B1.1", "label": "Cystic Fibrosis (CFTR-Related Chronic Airway Disease)", "parent": "B1", "level": 2, "status": "reopened", "prior": 0.21221097307573278, "posterior": 0.19954133207696192, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["MRI-documented airway dilation and chronic productive cough do not decisively confirm cystic fibrosis due to normal growth curve, but they are nonspecific features shared with structural and genetic conditions.", "Persistent sinus symptoms with airway dilation suggest PCD but the absence of situs inversus weakens its specificity, maintaining it as a possible but less definitive explanation."], "evidence_against": ["Normal weight gain argues against cystic fibrosis (B1.1) in a patient with chronic respiratory symptoms. However, absence of meconium ileus or pancreatic dysfunction only moderately reduces likelihood (CFTR mutations can still cause atypical presentations).", "Absence of pancreatic manifestations weakly contradicts cystic fibrosis but does not eliminate atypical CFTR presentations like those without early meconium ileus."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of meconium ileus or pancreatic insufficiency at birth", "Consistent history of sinus/airway symptoms in family members"], "requestable_discriminators": ["Sweat chloride test", "CFTR gene panel (e.g., F508del, G542X mutations)", "Chest CT to assess bronchiectasis vs. airway dilation patterns"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.9, "interrupt_relevance": 0.8, "level_role": "specific_disease", "classification_axis": "etiology"}, "B1.2": {"id": "B1.2", "label": "Primary Ciliary Dyskinesia (Immunodeficiency-Related Airway Dysfunction)", "parent": "B1", "level": 2, "status": "reopened", "prior": 0.04774746894203988, "posterior": 0.03741399976443037, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Chronic sinus symptoms in infancy are moderately supportive of PCD (B1.2), though absence of situs inversus weakens this. The persistent pattern suggests a structural/functional abnormality rather than reactive inflammation.", "Persistent sinus symptoms with airway dilation suggest PCD but the absence of situs inversus weakens its specificity, maintaining it as a possible but less definitive explanation."], "evidence_against": ["The absence of situs inversus directly weakens Primary Ciliary Dyskinesia (B1.2), but PCD without situs abnormalities can occur (not Kartagener syndrome). Subtle evidence remains supportive.", "Lack of situs inversus weakens but does not exclude PCD, as ~50% of PCD cases do not have this feature (non-Kartagener syndrome)."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of infant