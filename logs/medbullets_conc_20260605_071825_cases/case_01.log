es": ["Cervical radiculopathy: Ruled out by absence of positional symptom variation", "Isolated brainstem lesion: Less likely with purely unilateral limb deficit without contralateral involvement", "Corticosteroid-induced myopathy: Possible but less likely given motor-sensory component and pain", "Metastatic visceral mass syndrome: Considered but requires further characterization"], "alarm_features": ["17-pound weight loss", "chronic alcohol use", "chronic smoking", "age at presentation (55-year-old bodybuilder)"]}, "branches": {"B1": {"id": "B1", "label": "Structural Compression Neuropathy", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.18324607329842932, "danger": 0.1, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Chronic steroid use reduces muscle mass/volume but does not typically cause focal brachial plexopathy; bodybuilding primarily exacerbates musculotendinous injuries rather than nerve entrapment, yielding minimal direct clinical relevance"], "evidence_against": ["Absence of positional symptom variation effectively rules out cervical radiculopathy as a direct differential, but does not necessarily exclude all structural compression mechanisms at non-cervical sites"], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the patient have localized pressure symptoms or mechanical triggers?", "Are there signs of space-occupying lesion on imaging?"], "requestable_discriminators": ["Chest/X-ray or CT for apical mass", "MRI of brachial plexus or cervical spine"], "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.15, "interrupt_relevance": 0.05, "level_role": "family", "classification_axis": "anatomy"}, "B2": {"id": "B2", "label": "Chronic Inflammatory / Degenerative Neuromuscular Disease", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.2617801047120419, "danger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": [], "evidence_against": ["The combination of constitutional weight loss and brachial plexus symptoms with bodybuilding suggests an apical mass compressing the plexus, providing meaningful support to the malignancy differential"], "unresolved_questions": [], "children": ["B2.1", "B2.2", "B2.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Are there additional limb findings or symmetrical patterns?", "History of recent infections or autoimmune symptoms?"], "requestable_discriminators": ["Nerve conduction studies", "Autoimmune panels and inflammatory markers"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.1, "interrupt_relevance": 0.15, "level_role": "family", "classification_axis": "mechanism"}, "B3": {"id": "B3", "label": "Malignancy with Paraneoplastic or Direct Effects", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.15, "posterior": 0.28272251308900526, "danger": 0.4, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The combination of constitutional weight loss and brachial plexus symptoms with bodybuilding suggests an apical mass compressing the plexus, providing meaningful support to the malignancy differential"], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of systemic symptoms like night sweats or fevers?", "Any paraneoplastic features in other systems?"], "requestable_discriminators": ["Tumor marker panel", "PET scan for occult malignancy"], "turn_cost_to_refine": 3.0, "diagnosis_commitment_gain": 0.25, "interrupt_relevance": 0.35, "level_role": "family", "classification_axis": "etiology"}, "B4": {"id": "B4", "label": "Vascular Lesion with Neurological Consequences", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.1, "posterior": 0.18848167539267016, "