nfectious etiology (e.g., bacterial sepsis, TB): insufficient evidence in labs for acute inflammation (normal serum electrolytes and creatinine suggest no metabolic derangement)", "Autoimmune pancytopenia: less likely given the blast count elevation rather than proportional cell line suppression", "Metastatic visceral malignancy: possible but less specific than hematological cause given constitutional symptoms and blast cells"], "alarm_features": ["Weight loss", "Night sweats", "Fever", "Leukocytosis with blasts"]}, "branches": {"B1": {"id": "B1", "label": "Reactive / Non-malignant Leukocytosis", "level": 1, "status": "parked", "posterior": 0.129, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B2": {"id": "B2", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.2924409939558757, "posterior": 0.2924409939558757, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.8, "diagnosis_commitment_gain": 0.75, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute myeloid leukemia", "myelodysplastic syndrome with excess blasts", "chronic myeloid leukemia in blast crisis"]}, "B3": {"id": "B3", "label": "Lymphoid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.15508234527963102, "posterior": 0.15508234527963102, "danger": 0.85, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.85, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute lymphoblastic leukemia