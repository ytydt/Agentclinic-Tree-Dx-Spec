2.2", "B2.3", "B2.4"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Are there any mucosal ulcers, blisters, or vesicular lesions present in addition to the rash?", "History of fever, weight loss, or lymphadenopathy with prior rashes?"], "requestable_discriminators": ["PCR for HSV, HR-HPV, GC/CT, HIV", "Serology for syphilis (FTA-ABS, RPR)", "Lesion swab for mycoplasma/ureaplasma"], "turn_cost_to_refine": 3.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "etiology"}, "B3": {"id": "B3", "label": "Drug-Induced Cutaneous Hypersensitivity with Possible Cross-Triggering", "level": 1, "status": "parked", "posterior": 0.06849315068493149, "danger": 0.6, "parent": "ROOT", "closure_reason": "", "evidence_against": ["No known penicillin allergy combined with sexual trigger pattern strengthens allergy (B1) and STI (B2) possibilities against B3."]}, "B4": {"id": "B4", "label": "Systemic Vasculitic / Autoimmune Cutaneous Disorder with High-Risk History", "level": 1, "status": "parked", "posterior": 0.06849315068493149, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B1.1": {"id": "B1.1", "label": "Seminal Plasma Allergy / Sperm Allergy", "parent": "B1", "level": 2, "status": "live", "prior": 0.12328767123287668, "posterior": 0.12328767123287668, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the rash always occur during intercourse with partners using no barrier methods (suggesting seminal fluid as allergen)?"], "requestable_discriminators": ["Skin prick testing for seminal plasma proteins", "Serum IgE measurement against seminal antigens"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.3, "interrupt_relevance": 0.6, "level_role": "disease_cl