spects)"]}, "branches": {"B1": {"id": "B1", "label": "Insulin resistance-related metabolic disorder", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.481903817550818, "posterior": 0.5228045545294595, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Chronic risk factors and progressive symptoms slightly reduce likelihood of reactive hyperglycemia but don't resolve beta cell vs insulin resistance", "Classic insulin resistance presentation without acute decompensation signs strengthens consideration"], "evidence_against": [], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of prior hyperglycemia or diabetes diagnosis", "Family history of insulin resistance", "Presence of abdominal obesity or visceral fat distribution"], "requestable_discriminators": ["HbA1c testing for chronic hyperglycemia", "Insulin level quantification", "C-reactive protein (CRP) for systemic inflammation"], "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.3, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "mechanism"}, "B2": {"id": "B2", "label": "Beta cell destruction diabetes spectrum", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.044266591118351156, "posterior": 0.0512794800032819, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Weight loss is typical for beta cell destruction, but its absence doesn't exclude this as a potential safety concern.", "Clinical findings do not definitively exclude glucagonoma; the evidence slightly reduces but does not eliminate paraneoplastic consideration."], "evidence_against": ["Obesity with typical metabolic profile reduces urgency for hypercortisolism evaluation despite abnormal glucose", "Classic beta cell destruction typically presents with polyuria, but absence of these symptoms weakens support for acute T1DM."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of progressive weight loss in context of hyperglycemia", "Symptoms of polyuria/polydipsia onset acuity", "Family history of autoimmune diabetes"], "requestable_discriminators": ["Autoimmune diabetes antibodies (GAD, IA-2)", "C-peptide level assessment"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "mechanism"}, "B3": {"id": "B3", "label": "Hypercortisolism-related metabolic syndrome", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.04249592747361711, "posterior": 0.027349056001750343, "danger": 0.75, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": ["Obesity with typical metabolic profile reduces urgency for hypercortisolism evaluation despite abnormal glucose", "Chronic risk factors and presentation patterns provide moderate support for type 2 diabetes while reducing likelihood of hypercortisolism and paraneoplastic causes."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Clinical features of Cushing's syndrome (moon face/buffalo hump)", "History of exogenous steroid use", "Symptoms of hypokalemia/hypertension"], "requestable_discriminators": ["24-hour urinary cortisol", "ACTH stimulation testing", "Low-dose dexamethasone suppression test"], "turn_cost_to_refine": 3.0, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "mechanism"}, "B4": {"id": "B4", "label": "Paraneoplastic syndrome with metabolic derangements", "level": 1, "status": "closed_for_now", "posterior": 0.0364654080023338, "danger": 0.85, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B5": {"id": "B5", "label": "Reactive/Non-malignant Acute H