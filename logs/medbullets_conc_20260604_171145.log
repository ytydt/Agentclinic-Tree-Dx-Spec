at the patient has normal bowel movements and has been gaining weight appropriately. The patient has a history of tricuspid stenosis. She also recently had magnetic resonance imaging (MRI) of her chest which demonstrated dilation of her airways. Her temperature is 99.5°F (37.5°C), blood pressure is 90/58 mmHg, pulse is 120/min, respirations are 18/min, and oxygen saturation is 94% on room air. Physical exam is notable for bruises along the patient's shins which the guardians state are from playing soccer. The rest of the exam is deferred because the patient starts crying.", "static_question": "Which of the following findings is associated with this patient's most likely underlying diagnosis?", "static_options": [{"id": "A", "description": "Diastolic murmur best heard along the right lower sternal border"}, {"id": "B", "description": "Hypocalcemia"}, {"id": "C", "description": "Increased chloride in the patient's sweat"}, {"id": "D", "description": "Repeat sinus infections secondary to seasonal allergies"}, {"id": "E", "description": "Social withdrawal and avoidance of eye contact"}], "static_evidence_items": [{"id": "E1", "kind": "direct", "content": "Chief complaint: respiratory infection", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E2", "kind": "direct", "content": "Lives in a foster home with frequent admissions", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E3", "kind": "direct", "content": "History since birth: repeated frontal sinus pain/pressure episodes and chronic mucus-producing cough", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E4", "kind": "direct", "content": "Recent antibiotic treatment: amoxicillin for an infection", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E5", "kind": "direct", "content": "Growth parameters: 25th percentile for height and weight since birth", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E6", "kind": "direct", "content": "Guardians report: normal bowel movements and appropriate weight gain", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E7", "kind": "direct", "content": "Past medical history: tricuspid stenosis", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E8", "kind": "direct", "content": "Chest MRI findings: airway dilation", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E9", "kind": "direct", "content": "Vital signs: 99.5°F (37.5°C) temperature, 90/58 mmHg BP, 120/min pulse, 18/min respirations, 94% O2 saturation on room air", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E10", "kind": "direct", "content": "Physical exam findings: bruises along shins reported by guardians as soccer-related", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E11", "kind": "direct", "content": "Physical exam details: incomplete due to patient crying", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}], "seen_evidence_ids": [], "seen_evidence_phenotypes": "{'Chronic cough', 'Nonproductive cough'}", "mode_policy": {"benchmark_purity": true, "allow_external_knowledge": true}, "answer_option_mapping": {}, "tool_use_log": [], "root_revision_needed": false, "max_tree_depth": 3}
