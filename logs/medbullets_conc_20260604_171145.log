 0.0, "expand_score": 0.5, "evidence_for": [], "evidence_against": ["Unclear imaging features do not decisively support mechanical obstruction in a previously healthy marathon runner.", "Absence of classic mechanical obstruction signs increases consideration of non-mechanical ileus."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Are there signs of small bowel obstruction (e.g., crampy pain, vomiting bile-rich fluid)?", "Is there a prior history of gastrointestinal surgery or adhesions?", "Does imaging show dilated loops of bowel with transition point?", "Is there evidence of strangulation (peritonitis, fever)?"], "requestable_discriminators": ["CT scan of abdomen", "abdominal radiographs"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "mechanism"}, "B2": {"id": "B2", "label": "Non-Mechanical Bowel Obstruction", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.2529497795797703, "posterior": 0.24082405928347056, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Absence of classic mechanical obstruction signs increases consideration of non-mechanical ileus."], "evidence_against": ["The strongest evidence against ileus remains undefined in text-only analysis with no lab/imaging data."], "unresolved_questions": [], "children": ["B2.1", "B2.2", "B2.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Has the patient been hospitalized recently (post-operative ileus)?", "Are there signs of intra-abdominal inflammation (e.g., appendicitis, diverticulitis)?", "Does the patient have a history of GI dysmotility disorders?"], "requestable_discriminators": ["Plain film abdominal X-ray", "CT with oral contrast"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.7, "le