      "turn_cost_to_refine": 1.0,
      "diagnosis_commitment_gain": 0.0,
      "interrupt_relevance": 0.0,
      "why_included": "reason for inclusion and what management it implies"
    }
  ],
  "sub_frontier": ["B1.1", "B1.2"],
