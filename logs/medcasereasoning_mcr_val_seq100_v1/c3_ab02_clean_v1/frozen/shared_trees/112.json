p_leaves": false, "n_l1": 1, "n_l2": 0, "seed_base": 20260728}}, "branches": {"FLAT": {"id": "FLAT", "label": "Flat candidate pool (no L1 hierarchy)", "parent": "ROOT", "level": 1, "level_role": "family", "status": "live", "prior": 1.0, "posterior": 1.0, "danger": 0.0, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "classification_axis": "fixed_specialty", "representative_diseases": [], "askable_discriminators": [], "requestable_discriminators": [], "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "reopen_triggers": [], "children": [], "closure_reason": "", "diagnosis_commitment_gain": 0.0, "interrupt_relevance": 0.0, "turn_cost_to_refine": 1.0}}, "case_id": "112", "case_summary": "A 29-year-old Caucasian man with a history of hepatitis C, posttraumatic stress disorder, polysubstance abuse, and tobacco use was brought to the emergency department after being found agitated and erratically wandering the streets and then unresponsive with multiple skin abrasions. He reported ingestion and insufflation of “bath salts,” a history later confirmed by his family. He denied other medications or supplements and had no known drug allergies.\n\nOn examination, temperature was 107°F, blood pressure 91/52 mm Hg, and pulse 93/min. He was confused and intermittently agitated, with pupils 3 mm and equal. Cardiovascular exam showed weak peripheral pulses without jugular venous distention or murmurs; lungs were clear; abdomen was soft; no focal neurologic deficits.\n\nLaboratory studies on admission showed features of severe rhabdomyolysis. Serologic testing confirmed chronic hepatitis C but was otherwise unremarkable. Serum toxicology tests were negative for ethanol, acetaminophen, and salicylates. Urine toxicology detected only lorazepam and cotinine but was negative for over 80 other substances, including cannabinoids, cocaine, ecstasy, ephedrine, lysergide, methamphetamine, methylphenidate, oxycodone, and phencyclidine.\n\nNoncontrast CT of the head, MRI of the cervical spine, EEG, and chest and abdominal radiographs were normal. Right upper-quadrant ultrasonography revealed gallbladder calculi, a normal pancreatic duct, and an echogenic right kidney with prominent corticomedullary differentiation.\n\nHe received aggressive IV fluids, a norepinephrine infusion, and a bolus of amiodarone. Hyperkalemia was treated with sodium polystyrene sulfonate, calcium gluconate, insulin with glucose, and IV bicarbonate. For severe hyperthermia, he was given dantrolene and placed on cooling blankets. He was sedated, intubated, and mechanically ventilated, and received rasburicase for hyperuricemia. Urine output was 4200 mL over the first 24 hours, then declined to 825 mL and 150 mL over subsequent 24-hour periods. He was started on daily hemodialysis for volume control and solute clearance.", "frontier": ["FLAT"], "root": {"alarm_features": ["Severe hyperthermia", "Hypotension", "Acute kidney injury"], "confidence": 0.8, "excluded_candidates": ["Toxicity from other substances ( ruled out by negative toxicology screens)", "Infectious causes of multisystem organ dysfunction (not supported by laboratory findings)"], "label": "Acute Multisystem Organ Dysfunction with Severe Hyperthermia and Rhabdomyolysis", "salient_findings": ["Severe hyperthermia", "Hypotension", "Rhabdomyolysis", "Acute kidney injury", "Gallbladder calculi", "Echogenic right kidney with prominent corticomedullary differentiation"], "severity": "unspecified", "supporting_facts": ["Severe hyperthermia (temperature 107°F)", "Hypotension (blood pressure 91/52 mm Hg)", "Rhabdomyolysis with elevated serum creatine kinase", "Acute kidney injury with decreased urine output", "History of polysubstance abuse and ingestion of 'bath salts'"], "time_course": "acute"}, "static_evidence_items": [{"branch_links": {}, "content": "Demographics: 29-year-old Caucasian man", "id": "E1", "independent": true, "kind": "direct", "metadata": {"extractor": "diagnosisare