  "bc9130e8a6a8e2cae65500c38210a83b41d474c714e6dd75152f44189bd0cd9d": {
    "fact_rationales": {
      "F13": "Marked asymmetry of the cerebral hemispheres is a hallmark of hemimegalencephaly, which typically presents with an enlarged and abnormal hemisphere.",
      "F14": "Significant atrophy of the right cerebral hemisphere is more consistent with Rasmussen's encephalitis, which often presents with progressive hemispheric atrophy.",
      "F18": "Areas of cystic encephalomalacia surrounded by gliosis in the right fronto-parieto-temporal region are highly suggestive of Rasmussen's encephalitis, which is characterized by chronic inflammation and tissue damage.",
      "F9": "Significant cognitive impairment and marked left hemiparesis with brisk reflexes are consistent with both Rasmussen's encephalitis and hemimegalencephaly, but the combination of these findings with other evidence points more towards Rasmussen's encephalitis."
    },
