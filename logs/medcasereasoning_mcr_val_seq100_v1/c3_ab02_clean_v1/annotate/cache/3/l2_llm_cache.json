  "00fc0a6c43bd93d51420933d1106d4f4ff161541f439da14fc1fb87ae64e9c71": {
    "fact_rationales": {
      "F11": "Lumbar MRI showing a right-sided disc herniation at L5–S1 without significant nerve-root or cord compression is more typical of L5 radiculopathy, but also seen in spinal cord compression.",
      "F18": "Right foot drop is more typical of peroneal nerve palsy or L5 radiculopathy, but also seen in cauda equina syndrome and Guillain barre syndrome.",
      "F20": "Urgent MRI showing no new nerve-root compression makes spinal cord compression less likely, but does not rule out other conditions.",
      "F8": "Positive straight-leg-raising test is more typical of lumbar disc herniation, which can cause L5 radiculopathy or cauda equina syndrome."
    },
