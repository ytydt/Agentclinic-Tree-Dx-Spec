  "04657ecc500eabafff80e7c2ddafac70eceeeb6c8ed87713d17a48db6f45babb": {
    "fact_rationales": {
      "F11": "Tubular filling defect with partial obstruction of the right mid ureter is more typical of ureteral tumors such as transitional cell carcinoma or squamous cell carcinoma.",
      "F12": "A 5 cm long tubular mass in the mid ureter is more suggestive of a ureteral tumor such as transitional cell carcinoma or adenocarcinoma.",
      "F13": "A pedunculated ureteral tumor with a vulnerable surface is more typical of a benign tumor such as a fibroepithelial polyp or a leiomyoma, but can also be seen in malignant tumors.",
      "F16": "The absence of metastasis or lymphadenopathy on the staging CT scan makes metastatic disease less likely, but does not rule out a primary ureteral tumor."
    },
