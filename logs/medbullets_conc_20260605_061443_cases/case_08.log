sterior": 0.23989303130407424, "danger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The ECG pattern is suggestive of Mobitz type II AV block due to consistent PR intervals with intermittently blocked beats, which differentiates from sinus bradycardia.", "ECG findings support Mobitz II AV block over sinus bradycardia based on consistent PR intervals with dropped beats."], "evidence_against": ["Normal vital signs and youth status create a weak challenge to intrinsic AV pathophysiology as the primary diagnosis, maintaining neutrality for other branches.", "Normal QRS morphology argues against intrinsic AV structural disease, indirectly supporting reactive arrhythmia (B3)"], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3", "B1.4"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Are there episodes of syncope or near-syncope?", "Does the patient have a family history of conduction disorders?", "Are the palpitations associated with positional changes or exercise?"], "requestable_discriminators": ["ECG: PR interval consistency across beats (first degree vs. variable blocks)", "ECG: Presence of bundle branch block patterns (Mobitz I vs. II)", "ECG: Evidence of complete AV dissociation (third degree block)"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.85, "interrupt_relevance": 0.3, "level_role": "family", "classification_axis": "mechanism"}, "B2": {"id": "B2", "label": "Sinus Rhythm Abnormality", "level": 1, "status": "parked", "posterior": 0.2818939751455089, "danger": 0.1, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Fixed PR intervals with intermittent dropped beats (Mobitz II's signature) increase likelihood of intrinsic conduction system pathology over pure sinus bradycardia."]}, "B3": {"id": "B3", "label": "Reactive Arrhythmia with Caffeine Sensitivity", "parent": "ROOT", "level": 1, "status": "reopened", "prior": 0.1724137931034483, "posterior": 0.22652194431335537, "danger": 0.0, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Normal QRS morphology suggests arrhythmia may be triggered by external factors (e.g., caffeine) rather than intrinsic structural AV node disease.", "No consistent PR interval prolongation without dropout was observed, which rules out first-degree AV block and indirectly supports reactive causes."], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Exact timing of palpitations relative to caffeine intake", "Does symptom severity correlate with specific caffeine sources (coffee vs. energy drinks)?", "Any concurrent stress or anxiety symptoms?"], "requestable_discriminators": ["ECG: Evidence of tachycardia-bradycardia syndrome patterns", "ECG: Non-specific T-wave changes or sinusoidal pattern (pre-excitation)"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.65, "interrupt_relevance": 0.0, "level_role": "family", "classification_axis": "etiology"}, "B1.1": {"id": "B1.1", "label": "First Degree Atrioventricular Block", "level": 2, "status": "closed_for_now", "posterior": 0.03146138115463269, "danger": 0.1, "parent": "B1", "closure_reason": "", "evidence_against": ["No consistent PR interval prolongation without dropout was observed, which rules out first-degree AV block and indirectly supports reactive causes."]}, "B1.2": {"id": "B1.2", "label": "Second Degree Atrioventricular Block (Mobitz Type I - Wenckebach)", "level": 2, "status": "parked", "posterior": 0.05899008966493628, "danger": 0.2, "parent": "B1", "closure_reason": "", "evidence_against": ["Absence of PR interval progression eliminates Mobitz type I AV block as a consideration."]}, "B1.3": {"id": "B1.3", "label": "Second Degree Atrioventricular Block (Mobitz Type II - Non-Wenckebach)", "parent": "B1", "level": 2, "status": "reopened", "prior": 0.10775862068965517, "posterior": 0.1415762151958471, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["No evidence of progressive PR interval lengthening (Mobitz I's hallmark) was found, which reduces probability for Mobitz type I AV block.", "Fixed PR intervals with intermittent dropped beats (Mobitz II's signature) increase likelihood of intrinsic conduction system pathology over pure sinus bradycardia."], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Do symptoms occur in fixed cycles rather than varying PR intervals?"], "requestable_discriminators": ["ECG: Dropped QRS complexes with fixed PR intervals and dissociated P wave morphology"], "turn_cost_to_refine": 1.3, "diagnosis_commitment_gain": 0.5, "interrupt_relevance": 0.6, "level_role": "disease_class", "classification_axis": "mechanism"}, "B1.4": {"id": "B1.4", "label": "Third Degree Atrioventricular Block (Complete Heart Block)", "level": 2, "status": "closed_for_now", "posterior": 0.007865345288658171, "danger": 0.9, "parent": "B1", "closure_reason": "", "evidence_against": ["ECG findings confirm intermittent P-wave conduction rather than complete dissociation, definitively excluding third-degree block."]}}, "frontier": ["B1.3", "B3"], "other_mass": 0.0, "pending_results": [], "actions_taken": [{"timestep": 3, "bundle_id": 3, "bundle_position": 2, "bundle_size": 8, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Does the ECG in Figure A show complete AV dissociation (Q-T intervals uncorrelated with P waves), which would favor third-degree block over other branch forms?", "result_summary": "No complete P-R dissociation or independent P waves were detected, which excludes third-degree heart block as the primary explanation.", "per_action_branch_effects": {"B1.4": "strong_against"}}, {"timestep": 3, "bundle_id": 3, "bundle_position": 3, "bundle_size": 8, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Does the ECG in Figure A show normal QRS morphology without structural conduction pathology, which aligns with reactive arrhythmia as an explanation for intermittent palpitations?", "result_summary": "Normal QRS morphology suggests arrhythmia may be triggered by external factors (e.g., caffeine) rather than intrinsic structural AV node disease.", "per_action_branch_effects": {"B3": "moderate_for"}}, {"timestep": 3, "bundle_id": 3, "bundle_position": 4, "bundle_size": 8, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Does the ECG in Figure A show prolonged PR intervals across all conducted beats (no dropped complexes), which would rule out first-degree AV block as the explanation?", "result_summary": "No consistent PR interval prolongation without dropout was observed, which rules out first-degree AV block and indirectly supports reactive causes.", "per_action_branch_effects": {"B1.1": "weak_against", "B3": "moderate_for"}}, {"timestep": 3, "bundle_id": 3, "bundle_position": 5, "bundle_size": 8, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Are there ECG findings in Figure A that rule out Mobitz type I AV block (e.g., no evidence of PR interval progression or characteristic 'sawtooth' pattern)?", "result_summary": "Absence of PR interval progression eliminates Mobitz type I AV block as a consideration.", "per_action_branch_effects": {"B1.2": "moderate_against"}}, {"timestep": 3, "bundle_id": 3, "bundle_position": 6, "bundle_size": 8, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Does the ECG in Figure A show P waves that are dissociated from QRS complexes (complete AV dissociation), which would rule out Mobitz type II AV block in favor of third degree block?", "result_summary": "ECG shows intact conduction sequence in conducted beats, maintaining Mobitz type II as the most likely conduction pathology.", "per_action_branch_effects": {"B1.3": "neutral"}}, {"timestep": 3, "bundle_id": 3, "bundle_position": 7, "bundle_size": 8, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Are there any ECG features in Figure A that directly contradict third-degree AV block (e.g., intermittent P-wave conduction suggesting incomplete block)?", "result_summary": "ECG findings confirm intermittent P-wave conduction rather than complete dissociation, definitively excluding third-degree block.", "per_action_branch_effects": {"B1.4": "strong_against"}}], "differential_history": [{"B1": 0.3302752293577982, "B2": 0.5779816513761468, "B3": 0.09174311926605505}, {"B1": 0.3448275862068966, "B2": 0.4827586206896552, "B3": 0.1724137931034483, "B1.1": 0.05387931034482758, "B1.2": 0.16163793103448273, "B1.3": 0.10775862068965517, "B1.4": 0.021551724137931032}, {"B1": 0.23989303130407424, "B2": 0.2818939751455089, "B3": 0.22652194431335537, "B1.1": 0.03146138115463269, "B1.2": 0.05899008966493628, "B1.3": 0.1415762151958471, "B1.4": 0.007865345288658171}], "deliberation": {}, "interrupt": {"active": false, "reason": "No immediate instability markers identified (airway, breathing, circulation stable; no uncontrolled bleeding or herniation risk). Mobitz type II and sinus bradycardia remain differentials, but patient is asymptomatic with normal vital signs.", "required_actions": []}, "termination": {"ready_to_stop": false, "termination_type": "continue", "reason": "Leading branch B2 (Sinus bradycardia) has posterior=0.4827 (below 0.75). B1.3 (Mobitz II) retains posterior=0.1077 with danger=0.8. Discriminators (e.g., syncope history, family conduction disorders) still available to resolve ambiguity despite partial ECG analysis."}, "turn_budget_used": 3, "estimated_remaining_value": 0.8, "max_turn_budget": 5, "latest_action_type": "ANALYZE_VIGNETTE", "diagnosis_readiness_score": 0.2818939751455089, "benchmark_output_ready": false, "static_vignette": "A 24-year-old woman presents to clinic for a routine annual exam. She has generally been feeling well, but notes feeling intermittent palpitations over the past few months. Her past medical history is unremarkable and she is not currently taking any medications. She denies drinking alcohol, smoking cigarettes, or using recreational drugs. She attributes her palpitations to recently drinking more caffeine, but would like to obtain an electrocardiogram since her symptoms are worrisome and affecting her ability to concentrate on her career as a fitness instructor. Her temperature is 36.9°C (98.4°F), blood pressure is 116/76 mmHg, pulse is 55/min, respirations are 12/min, and oxygen saturation is 98% on room air. Her electrocardiogram is shown in Figure A.", "static_question": "Which of the following is the most likely diagnosis?", "static_options": [{"id": "A", "description": "First degree atrioventricular block"}, {"id": "B", "description": "Second degree atrioventricular block, Mobitz type I"}, {"id": "C", "description": "Second degree atrioventricular block, Mobitz type II"}, {"id": "D", "description": "Sinus bradycardia"}, {"id": "E", "description": "Third degree atrioventricular block"}], "static_evidence_items": [{"id": "E1", "kind": "direct", "content": "24-year-old woman with routine annual exam", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E2", "kind": "direct", "content": "Chief complaint: intermittent palpitations for past few months", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E3", "kind": "direct", "content": "Past medical history: unremarkable", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E4", "kind": "direct", "content": "No current medications", "source_ids": [], "independent": true, "branch_links": {}, "metadata": {}}, {"id": "E5", "kind": "direct", "content": "Social history: denies alcohol, smoking, and recreational