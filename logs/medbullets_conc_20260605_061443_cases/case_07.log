OT", "level": 1, "status": "expanded", "prior": 0.32298801369863017, "posterior": 0.33304066642396724, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The acute-onset dyspnea and significant inspiratory BP drop (Beck sign variant) increase suspicion for acute pericardial effusion (tamponade) rather than chronic pericardial disease.", "Chronic symptoms such as ascites or night sweats are typical of constrictive pericarditis, making their absence a negative predictor for this diagnosis."], "evidence_against": [], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Is there a history of recent viral infection or surgery?", "Are there signs of hemodynamic instability (syncope, hypotension)?"], "requestable_discriminators": ["Repeat bedside echocardiogram for pericardial effusion size and tamponade signs", "Chest X-ray for signs of pericardial effusion (widespread meniscus sign)"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "anatomy"}, "B2": {"id": "B2", "label": "Chronic Pericardial Constriction", "level": 1, "status": "closed_for_now", "posterior": 0.009536212176371071, "danger": 0.6, "parent": "ROOT", "closure_reason": "", "evidence_against": ["4-week interval aligns with typical post-surgical timing of autoimmune pericarditis (B1.2.1), moderately strengthening this sub-branch despite absence of direct infection evidence."]}, "B3": {"id": "B3", "label": "Acute Coronary Obstruction with Diastolic Dysfunction", "level": 1, "status": "closed_for_now", "posterior": 0.0076289697410968586, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Cold lacks specificity for EBV viral pericarditis (B1.1.1); viral etiologies are weakened but not excluded by absence of localized EBV features."]}, "B4": {"id": "B4", "label": "Thromboembolic Pulmonary Disease with Right Heart Strain", "level": 1, "status": "parked", "posterior": 0.020343919309591618, "danger": 0.75, "parent": "ROOT", "closure_reason": "", "evidence_against": ["4-week interval aligns with typical post-surgical timing of autoimmune pericarditis (B1.2.1), moderately strengthening this sub-branch despite absence of direct infection evidence."]}, "B5": {"id": "B5", "label": "Restrictive Cardiac Conditions with Diastolic Impairment", "level": 1, "status": "closed_for_now", "posterior": 0.0031787373921236908, "danger": 0.55, "parent": "ROOT", "closure_reason": "", "evidence_against": ["4-week interval aligns with typical post-surgical timing of autoimmune pericarditis (B1.2.1), moderately strengthening this sub-branch despite absence of direct infection evidence."]}, "B6": {"id": "B6", "label": "Reactive Inflammatory Cardiac Conditions", "level": 1, "status": "closed_for_now", "posterior": 0.004068783861918324, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": ["4-week interval aligns with typical post-surgical timing of autoimmune pericarditis (B1.2.1), moderately strengthening this sub-branch despite absence of direct infection evidence."]}, "B1.1": {"id": "B1.1", "label": "Viral-Induced Acute Pericardial Effusion with Tamponade", "parent": "B1", "level": 2, "status": "expanded", "prior": 0.12810359589041098, "posterior": 0.08229650727027432, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The recent cold increases suspicion of viral-induced pericardial effusion (B1.1), a common cause of acute pericardial disease. However, without chest pain relieved by sitting forward (a hallmark of viral pericarditis), this evidence remains inconclusive."], "evidence_against": ["Classic signs of viral pericarditis, such as chest pain alleviated by sitting forward, are absent in this patient. This weakens but does not exclude viral etiology (B1.1), necessitating further assessment.", "Missing typical viral pericarditis symptoms (e.g., chest pain alleviated by sitting forward) weakens support for viral-induced tamponade (B1.1) and reactive inflammatory pericardial disease (B6), though does not fully exclude them."], "unresolved_questions": [], "children": ["B1.1.1", "B1.1.2", "B1.1.3", "B1.1.4"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the pericardial effusion correlate with recent upper respiratory infection (cold)?", "Are there symptoms of pericarditis, such as chest pain, which is relieved by sitting forward?"], "requestable_discriminators": ["PCR for EBV/CMV", "Pericardial fluid analysis for lymphocytic predominance"], "turn_cost_to_refine": 1.2, "diagnosis_commitment_gain": 0.75, "interrupt_relevance": 0.9, "level_role": "disease_class", "classification_axis": "etiology"}, "B1.2": {"id": "B1.2", "label": "Post-Surgical Pericardial Effusion with Tamponade", "parent": "B1", "level": 2, "status": "expanded", "prior": 0.17080479452054798, "posterior": 0.22665267576075548, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The subacute onset (4 weeks post-surgery) and immobilization increase the plausibility of post-surgical pericardial effusion (B1.2). Surgical pericardial complications can manifest later due to delayed fluid accumulation."], "evidence_against": ["The surgical history lacks direct evidence of pericardial injury or retrograde stasis, which are critical for post-surgical effusion diagnosis (B1.2). This weakens the argument for this sub-branch despite temporal correlation."], "unresolved_questions": [], "children": ["B1.2.1", "B1.2.2", "B1.2.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the effusion occur within 6 weeks of Achilles tendon surgery?", "Is there evidence of retrograde venous stasis or pericardial injury in surgical history?"], "requestable_discriminators": ["Doppler ultrasound for postoperative thrombosis", "CT chest with contrast to evaluate surgical complication"], "turn_cost_to_refine": 1.3, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.85, "level_role": "disease_class", "classification_axis": "management_pathway"}, "B1.3": {"id": "B1.3", "label": "Neoplastic Pericardial Effusion with Tamponade", "level": 2, "status": "parked", "posterior": 0.024091483392937447, "danger": 0.9, "parent": "B1", "closure_reason": "", "evidence_against": ["Abnormal neoplasm signs were not described, making neoplastic effusion less likely, though ECG findings like low voltage in Figure A remain unconfirmed to definitively exclude it."]}, "B1.1.1": {"id": "B1.1.1", "label": "Epstein-Barr Virus (EBV) Induced Pericardial Tamponade", "parent": "B1.1", "level": 3, "status": "live", "prior": 0.060680650684931524, "posterior": 0.0485684305201619, "danger": 0.85, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["A recent cold suggests post-viral pericarditis, but absence of characteristic EBV symptoms (e.g., chest pain relieved by sitting forward) reduces specificity for EBV-induced tamponade.", "Cold lacks specificity for EBV viral pericarditis (B1.1.1); viral etiologies are weakened but not excluded by absence of localized EBV features."], "evidence_against": ["Absence of localized ST elevation refutes myocardial infarction (B3) but has neutral effect on pericardial pathologies given low voltage possibility."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does EBV serology in the context of pericarditis align with recent upper respiratory infection?", "Was the recent cold a known EBV reactivation in this patient?"], "requestable_discriminators": ["EBV DNA PCR in serum/pericardial fluid", "EBV antibody panel (VCA, EA, EBNA)"], "turn_cost_to_refine": 1.1, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.75, "level_role": "specific_disease", "classification_axis": "etiology"}, "B1.1.2": {"id": "B1.1.2", "label": "Cytomegalovirus (CMV) Induced Pericardial Tamponade", "level": 3, "status": "parked", "posterior": 0.016864038375056213, "danger": 0.85, "parent": "B1.1", "closure_reason": "", "evidence_against": ["Absence of localized ST elevation refutes myocardial infarction (B3) but has neutral effect on pericardial pathologies given low voltage possibility."]}, "B1.1.3": {"id": "B1.1.3", "label": "Coxsackievirus Induced Pericardial Tamponade", "level": 3, "status": "parked", "posterior": 0.008432019187528107, "danger": 0.85, "parent": "B1.1", "closure_reason": "", "evidence_against": ["Absence of localized ST elevation refutes myocardial infarction (B3) but has neutral effect on pericardial pathologies given low voltage possibility."]}, "B1.1.4": {"id": "B1.1.4", "label": "Parvovirus B19 Induced Pericardial Tamponade", "level": 3, "status": "parked", "posterior": 0.008432019187528107, "danger": 0.85, "parent": "B1.1", "closure_reason": "", "evidence_against": ["4-week interval aligns with typical post-surgical timing of autoimmune pericarditis (B1.2.1), moderately strengthening this sub-branch despite absence of direct infection evidence."]}, "B1.2.1": {"id": "B1.2.1", "label": "Postoperative Dressler Syndrome (Autoimmune Pericarditis)", "parent": "B1.2", "level": 3, "status": "live", "prior": 0.08090753424657536, "posterior": 0.14570529156048567, "danger": 0.75, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Absence of localized ST elevation refutes myocardial infarction (B3) but has neutral effect on pericardial pathologies given low voltage possibility.", "4-week interval aligns with typical post-surgical timing of autoimmune pericarditis (B1.2.1), moderately strengthening this sub-branch despite absence of direct infection evidence."], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers"