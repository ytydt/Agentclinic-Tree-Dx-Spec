lastic Endocrine Disorder with Paraneoplastic Features", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.16660436488444821, "danger": 0.85, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": [], "evidence_against": ["The patient's obesity and metabolic risk factors support insulin resistance as a plausible mechanism for inflammatory skin changes and GI symptoms through chronic inflammation pathways.", "The short symptom duration and absence of constitutional signs (weight loss, cachexia) modestly reduce likelihood of neoplastic etiologies."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3", "B1.4"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of weight loss or polyuria beyond 1 week duration", "Symptoms of hypoglycemia (if any)"], "requestable_discriminators": ["Serum C-peptide and insulinoma antigen (INSA) testing", "CT/PET imaging for neuroendocrine tumors"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.75, "level_role": "family", "classification_axis": "mechanism"}, "B2": {"id": "B2", "label": "Autoimmune Endocrinopathy with Systemic Involvement", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.3939240020464378, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The 1-week progression is borderline for autoimmune endocrinopathies, which typically have slower presentations, but does not completely rule them out.", "Painful rashes suggest active inflammatory processes, which are more characteristically autoimmune than insulin resistance-associated skin changes."], "evidence_against": ["The patient's obesity and metabolic risk factors support insulin resistance as a plausible mechanism for inflammatory skin changes and GI symptoms through chronic inflammation pathways.", "Lack of classic Type 1 diabetes symptoms weakens but does not completely refute autoimmune beta cell destruction as a potential mechanism."], "unresolved_questions": [], "children": ["B2.1", "B2.2", "B2.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Family history of autoimmune diabetes", "Age-inappropriate presentation for Type 1 diabetes"], "requestable_discriminators": ["Autoantibodies (islet cell, GAD65), HbA1c trajectory over days"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.6, "level_role": "family", "classification_axis": "mechanism"}, "B3": {"id": "B3", "label": "Hypermetabolic Endocrine Syndrome", "level": 1, "status": "parked", "posterior": 0.06785293815153953, "danger": 0.75, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Normal thermoregulation and absence of weight loss argues against hypermetabolic endocrine syndrome despite severe hyperglycemia."]}, "B4": {"id": "B4", "label": "Metabolic Syndrome with Secondary Inflammatory Skin Changes", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.48, "posterior": 0.24556301426271446, "danger": 0.55, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The painful, erythematous rash with papules/plaques does not show steatotic or purpuric patterns typical of hypercortisolism.", "The patient's obesity and metabolic risk factors support insulin resistance as a plausible mechanism for inflammatory skin changes and GI symptoms through chronic inflammation pathways."], "evidence_against": ["Painful rashes suggest active inflammatory processes, which are more characteristically autoimmune than insulin resistance-associated skin changes."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Pattern of rash (steatotic dermatitis, necrobiosis lipoidica)", "Weight gain patterns"], "requestable_discriminators": ["HOMA-IR, lipid profile, fasting blood glucose", "Skin biopsy for acanthosis nigricans or necrobiosis"], "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.5, "interrupt_relevance": 0.4, "level_role": "family", "classification_axis": "risk_context"}, "B5": {"id": "B5", "label": "Reactive Endocrine-Immune Cross-Syndrome", "level": 1, "status": "parked", "posterior": 0.12605568065486009, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B1.1": {"id": "B1.1", "label": "Alpha Cell Tumor (Glucagonoma)", "parent": "B1", "level": 2, "status": "live", "prior": 0.052063864026390065, "posterior": 0.052063864026390065, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of weight loss or lichenoid skin lesions"], "requestable_discriminators": ["Serum glucagon, upper abdominal CT scan"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.3, "interrupt_relevance": 0.65, "level_role": "disease_class", "classification_axis": "etiology"}, "B1.2": {"id": "B1.2", "label": "Adrenal Cortical Carcinoma with Excess ACTH/CRH", "parent": "B1", "level": 2, "status": "live", "prior": 0.041651091221112053, "posterior": 0.041651091221112053, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Symptoms of central obesity or proximal muscle weakness"], "requestable_discriminators": ["24-hour urinary free cortisol, serum cortisol/ACTH ratio"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.25, "interrupt_relevance": 0.7, "level_role": "disease_class", "classification_axis": "anatomy"}, "B1.3": {"id": "B1.3", "label": "Pancreatic Beta Cell Tumor with Paraneoplastic Hyperglycemia", "parent": "B1", "level