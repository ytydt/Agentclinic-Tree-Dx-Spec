": 1, "status": "closed_for_now", "posterior": 0.0059964465067000325, "danger": 0.85, "parent": "ROOT", "closure_reason": "", "evidence_against": ["While NG decompression with NG insertion usually suggests higher obstructions, the rectal evacuation of stool implies the obstruction is not strictly proximal. This moderately weakens malrotation (B1.2) as a primary consideration."]}, "B3": {"id": "B3", "label": "Genetic/Chromosomal Anomalies with GI Manifestations", "level": 1, "status": "closed_for_now", "posterior": 0.002862951454010623, "danger": 0.75, "parent": "ROOT", "closure_reason": "", "evidence_against": ["While NG decompression with NG insertion usually suggests higher obstructions, the rectal evacuation of stool implies the obstruction is not strictly proximal. This moderately weakens malrotation (B1.2) as a primary consideration."]}, "B4": {"id": "B4", "label": "Neonatal Functional Intestinal Obstruction", "level": 1, "status": "parked", "posterior": 0.016369141711699325, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Physical exam findings (upslanting fissures, epicanthals, and single transverse crease) are consistent with Down syndrome suspicion but could represent normal variation. Karyotype testing remains the definitive test needed to upgrade this to a specific diagnosis."]}, "B5": {"id": "B5", "label": "Neonatal Pyloric/Gastric Obstruction", "level": 1, "status": "closed_for_now", "posterior": 1.5073271026780575e-06, "danger": 0.5, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Rectal evacuation is atypical for pyloric stenosis, which lacks distal passage of stool/meconium. This provides strong evidence in favor of meconium ileus (B1.3) as a specific low-lying obstruction pattern."]}, "B1.1": {"id": "B1.1", "label": "Duodenal Atresia with Double Bubble Sign", "level": 2, "status": "closed_for_now", "posterior": 0.0005639845701598401, "danger": 0.85, "parent": "B1", "closure_reason": "", "evidence_against": 