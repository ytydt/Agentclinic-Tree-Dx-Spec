"], "excluded_candidates": ["Ectopic pregnancy: OCP use reduces but does not eliminate risk; beta-hCG pending", "Alcohol-induced acute pancreatitis: less likely due to right-sided localization", "Hepatic abscess: plausible given alcohol use and constitutional signs", "Ruptured ovarian cyst: possible but less urgent than sepsis/acute abdomen"], "alarm_features": ["Hemodynamic instability (shock)", "Severe focal pain with systemic signs"]}, "branches": {"B1": {"id": "B1", "label": "Acute Cholecystitis / Biliary Tract Disease", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.4516129032258066, "posterior": 0.6369941999492221, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Subacute right upper quadrant pain and recent weight loss provide moderate support for cholecystitis as a possible cause."], "evidence_against": ["The absence of jaundice, fever, or ascites provides the strongest evidence against biliary tract disease."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B2": {"id": "B2", "label": "Acute Hepatic Pathology (Abscess, Infarct, Rupture)", "level": 1, "status": "parked", "posterior": 0.079, "danger": 0.9, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Lack of jaundice/fever/ascites moderately weakens the hepatic pathology hypothesis."]}, "B3": {"id": "B3", "label": "Acute Gynecological Emergencies (Ectopic Pregnancy, Ovarian Rupture, Torsion)", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.20322580645161295, "posterior": 0.18185156998550375, "danger": 0.95, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Shock signs hint at gynecological emergencies, but OCP use and absent bleeding provide only weak disconfirmation."], "evidence_against": ["Absent vaginal bleeding/adnexal mass provides moderate disconfirmation for gynecological emergencies."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.2, "diagnosis_commitment_gain": 0.65, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "urgency", "representative_diseases": []}, "B4": {"id": "B4", "label": "Acute Vascular Emergencies (Hepatic Vein Thrombosis, Budd-Chiari Syndrome)", "level": 1, "status": "parked", "posterior": 0.101, "danger": 0.9, "parent": "ROOT", "closure_reason": "", "evidence_against": ["No thrombotic risk factors weakly challenge vascular emergencies like Budd-Chiari syndrome."]}, "B5": {"id": "B5", "label": "Acute Pancreatitis / Peripancreatic Complications", "level": 1, "status": "parked", "posterior": 0.002, "danger": 0.75, "parent": "ROOT", "closure_reason": "", "evidence_against": []}}, "frontier": ["B1", "B3"], "other_mass": 0.0, "pending_results": [], "actions_taken": [{"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the hypotension and tachycardia suggest a ruptured ectopic pregnancy despite the patient's OCP use and lack of vaginal bleeding?", "summary": "Shock signs hint at gynecological emergencies, but OCP use and absent bleeding provide only weak disconfirmation."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the sudden worsening of right upper quadrant pain during exercise suggest Budd-Chiari syndrome or other hepatic vascular obstruction?", "summary": "Exercise-induced exacerbation of RUQ pain is a weak but plausible feature of Budd-Chiari syndrome."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the absence of jaundice, fever, or ascites in the case text challenge the hepatic pathology hypothesis?", "summary": "Lack of jaundice/fever/ascites moderately weakens the hepatic pathology hypothesis."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the absence of vaginal bleeding or a palpable adnexal mass challenge the gynecological emergency hypothesis?", "summary": "Absent vaginal bleeding/adnexal mass provides moderate disconfirmation for gynecological emergencies."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the lack of known thrombotic risk factors (e.g., clotting disorders) challenge the vascular emergency hypothesis?", "summary": "No thrombotic risk factors weakly challenge vascular emergencies like Budd-Chiari syndrome."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "What evidence is MOST INCONSISTENT with Acute Cholecystitis / Biliary Tract Disease? Identify the single strongest finding that argues against this diagnosis.", "summary": "The absence of jaundice, fever, or ascites provides the strongest evidence against biliary tract disease."}], "differential_history": [], "deliberation": {}, "interrupt": {"active": true, "reason": "Patient presents with hypotension (80/40 mmHg) and tachycardia (110 bpm), meeting criteria for shock/hemodynamic instability. These findings require immediate intervention before diagnostic resolution.", "required_actions": ["Initiate vasopressors if fluids fail", "Order repeat vital signs", "Prepare for rapid diagnostic imaging (e.g., FAST exam)"]}, "termination": {"ready_to_stop": false, "termination_type": "continue", "reason": ""}, "turn_budget_used": 0, "estimated_remaining_value": 0.65, "max_turn_budget": 5, "latest_action_type": "ANALYZE_VIGNETTE", "diagnosis_readiness_score": 0.0, "benchmark_output_ready": false, "static_question": "Which of the following is the most likely the diagnosis?", "static_options": [{"id": "A", "description": "Ectopic implantation of a blastocyst"}, {"id": "B", "description": "Inflammation of the pancreas"}, {"id": "C", "description": "Obstruction of blood flow through the hepatic vein"}, {"id": "D", "description": "Obstruction of the common bile duct by radio-opaque stones"}, {"id": "E", "description": "Vascular ectasia within the liver"}], "seen_evidence_ids": [], "seen_evidence_phenotypes":