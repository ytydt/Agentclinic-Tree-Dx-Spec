ne"], "alarm_features": ["Constitutional symptoms (fatigue, night sweats, abdominal fullness)", "Massive splenomegaly", "Severe cytopenias (anemia, thrombocytopenia) with petechiae", "Acute visual deterioration (retinal hemorrhages/cotton-wool spots)", "Blast percentage >80% in peripheral blood (strong neoplasm alarm)"]}, "branches": {"B1": {"id": "B1", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.8866995073891626, "posterior": 0.5290278254895224, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Leukostasis with fundoscopic findings (retinal hemorrhages with cotton-wool spots) is highly specific to blast crisis in myeloid neoplasms (B1), which supports this branch and undermines chronic/accelerated phase CML (B2) due to the acute presentation.", "The lack of prior chronic MPN symptoms combined with retinal leukostasis is more congruent with de novo myeloid neoplasm (B1) than with CML's chronic/accelerated phase progression (B2), given the typically indolent course of early CML."], "evidence_against": [], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of chronic phase symptoms before this acute presentation?", "Recent signs of infection or autoimmune process?", "Known Philadelphia chromosome status?"], "requestable_discriminators": ["BCR-ABL1 transcript testing", "Cytogenetic banding analysis", "Bone marrow aspiration with blast morphology"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.9, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "etiology"}, "B2": {"id": "B2", "label": "Chronic Myeloproliferative Neoplasm (chronic/accelerated phase)", "parent": "ROOT", "level": 1, "status": "reopened", "prior": 0.07037297677691766, "posterior": 0.01717622810030917, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["No direct contradiction to myeloid neoplasm was identified despite the high blast count (82%) and retinal signs of leukostasis. These findings align with both de novo AML (B1) and CML in blast crisis (sub-category of B1)."], "evidence_against": ["The 3-week timeline with acute visual symptoms is inconsistent with CML-BC's phase transformation (B1.2) which typically follows a more gradual chronic MPN course. Supports B1.1 as more likely.", "The 3-week subacute trajectory contradicts chronic MPN progression (B2), which typically requires years for transformation. This decisively excludes B2 as a viable explanation."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Has the patient had a prior diagnosis of chronic MPN?", "Any family history of myeloid disorders?", "History of polycythemia or thrombosis events?"], "requestable_discriminators": ["Ph chromosome/BCR-ABL1 testing", "JAK2 mutation analysis", "Bone marrow fibrosis assessment"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.75, "interrupt_relevance": 0.6, "level_role": "family", "classification_axis": "time_course"}, "B3": {"id": "B3", "label": "Lymphoid Neoplasm with Increased Blasts", "level": 1, "status": "parked", "posterior": 0.013740982480247339, "danger": 0.85, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The lack of prior chronic MPN symptoms combined with retinal leukostasis is more congruent with de novo myeloid neoplasm (B1) than with CML's chronic/accelerated phase progression (B2), given the typically indolent course of early CML."]}, "B4": {"id": "B4", "label": "Lymphoproliferative / Plasma Cell Disorder", "level": 1, "status": "parked", "posterior": 0.005496392992098934, "danger": 0.4, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The lack of prior chronic MPN symptoms combined with retinal leukostasis is more congruent with de novo myeloid neoplasm (B1) than with CML's chronic/accelerated phase progression (B2), given the typically indolent course of early CML."]}, "B5": {"id": "B5", "label": "Reactive / Non-malignant Leukocytosis", "level": 1, "status": "closed_for_now", "posterior": 0.001717622810030917, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The lack of prior chronic MPN symptoms combined with retinal leukostasis is more congruent with de novo myeloid neoplasm (B1) than with CML's chronic/accelerated phase progression (B2), given the typically indolent course of early CML."]}, "B1.1": {"id": "B1.1", "label": "De Novo Acute Myeloid Leukemia (AML)", "parent": "B1", "level": 2, "status": "live", "prior": 0.4926108374384237, "posterior": 0.4328409481277911, "danger": 0.85, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["The 3-week timeline with acute visual symptoms is inconsistent with CML-BC's phase transformation (B1.2) which typically follows a more gradual chronic MPN course. Supports B1.1 as more likely.", "The 3-week timeline is inconsistent with MDS-EB's (B1.3) gradual blast accumulation. The rapid onset favors de novo AML (B1.1) as MDS-EB rarely presents with sudden 82% blasts."], "evidence_against": ["8% basophilia provides weak support for CML lineage (B1.2) but doesn't outweigh evidence for de novo AML (B1.1) in the absence of prior CML documentation."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Absent prior myeloid clonal disorder", "No evidence of myelodysplasia in bone marrow"], "requestable_discriminators": ["Karyotype with absence of Philadelphia chromosome", "Mutation analysis for NPM1, DNMT3A (AML-associated)"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.9, "interrupt_relevance": 0.8, "level_role": "specific_disease", "classification_axis": "etiology"}, "B1.2": {"id": "B1.2", "label": "CML in Blast Crisis (Phase Transition from Chronic/MPN)", "level": 2, "status": "parked", "posterior": 0.048093438680865686, "danger": 0.7, "parent": "B1", "closure_reason": "", "evidence_against": ["The complete absence of prior MPN symptoms decisively undermines B1.2. CML blast crisis requires documented phase progression from earlier CML, not de novo presentation."]}, "B1.3": {"id": "B1.3", "label": "Myelodysplastic Syndrome with Excess Blasts (MDS-EB) / Secondary AML", "level": 2, "status": "parked", "posterior": 0.048093438680865686, "danger": 0.75, "parent": "B1", "closure_reason": "", "evidence_against": ["The 3-week timeline is inconsistent with MDS-EB's (B1.3) gradual blast accumulation. The rapid onset favors de novo AML (B1.1) as MDS-EB rarely presents with sudden 82% blasts."]}}, "frontier": ["B1.1", "B1.1", "B2"], "other_mass": 0.0, "pending_results": [], "actions_taken": [{"timestep": 2, "bundle_id": 2, "bundle_position": 1, "bundle_size": 7, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Does the subacute 3-week clinical trajectory with acute visual deterioration represent CML in blast crisis (B1.2) rather than de novo AML (B1.1)?", "result_summary": "The 3-week timeline with acute visual symptoms is inconsistent with CML-BC's phase transformation (B1.2) which typically follows a more gradual chronic MPN course. Supports B1.1 as more likely.", "per_action_branch_effects": {"B1.1": "moderate_for", "B1.2": "moderate_against", "B2": "weak_against"}}, {"timestep": 2, "bundle_id": 2, "bundle_position": 2, "bundle_size": 7, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Does the presence of blasts (82%) and marrow fibrosis (implied by splenomegaly) strongly support myeloid dysplasia/secondary AML (B1.3) as opposed to clonal evolution from prior CMML?", "result_summary": "82% blasts with splenomegaly are more consistent with acute transformation patterns of myeloid disorders (B1 family) than gradual MDS-EB (B1.3) based on cellularity and timeline.", "per_action_branch_effects": {"B1.3": "moderate_for", "B1.2": "neutral", "B2": "neutral", "B1.1": "neutral"}}, {"timestep": 2, "bundle_id": 2, "bundle_position": 3, "bundle_size": 7, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Could the 8% basophilia argue against de novo AML (B1.1) in favor of CML with accelerated phase transformation (B1.2) as a potential source of blasts?", "result_summary": "8% basophilia provides weak support for CML lineage (B1.2) but doesn't outweigh evidence for de novo AML (B1.1) in the absence of prior CML documentation.", "per_action_branch_effects": {"B1.2": "moderate_for", "B1.1": "weak_against", "B1.3": "neutral"}}, {"timestep": 2, "bundle_id": 2, "bundle_position": 4, "bundle_size": 7, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "What evidence contradicts CML in blast crisis (B1.2)? Is the absence of documented prior MPN symptoms sufficient to argue against phase transition from chronic CML?", "result_summary": "The complete absence of prior MPN symptoms decisively undermines B1.2. CML blast crisis requires documented phase progression from earlier CML, not de novo presentation.", "per_action_branch_effects": {"B1.2": "strong_against", "B1.1": "neutral", "B1.3": "neutral"}}, {"timestep": 2, "bundle_id": 2, "bundle_position": 5, "bundle_size": 7, "action_type": "ANALYZE_VIGNETTE", "external_action": "ANALYZE_VIGNETTE", "content": "Does the subacute 3-week timeline with 82% blasts in peripheral blood align with MDS-EB's typical gradual progression pattern or does it favor de novo AML (B1.1) with sudden blast predominance?", "result_summary": "The 3-week timeline is inconsistent with MDS-EB's (B1.3) gradual blast accumulation. The rapid onset favors de novo AML (B1.1) as MDS-EB rarely presents with sudden 82% blasts.", "per_action_branch_effects": {"B1.3": "strong_against", "B1.1": "strong_for", "B2": "n