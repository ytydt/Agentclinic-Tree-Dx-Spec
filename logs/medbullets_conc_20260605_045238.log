verage": 0.0, "expand_score": 0.0, "evidence_for": ["The presence of Down syndrome features and rectal evacuation in a term neonate with delayed stool passage strongly supports Hirschsprung disease (B2.1) due to its well-documented association with trisomy 21 and partial aganglionosis allowing gas/fluid communication.", "Down syndrome features and rectal flatus passage provide weak against evidence for malrotation/volvulus (B1.2), which presents more commonly with acute bilious vomiting and imaging findings of closed-loop obstruction rather than partial patency."], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of delayed passage of meconium (in this case, no stool passed since birth supports the diagnosis)", "Presence of Down syndrome features (upslanting palpebral fissures, single palmar crease) which are strongly associated with Hirschsprung disease"], "requestable_discriminators": ["Rectal biopsy showing absence of ganglion cells confirming aganglionosis", "Rectal manometry (out-of-phase contractions) to differentiate from other motility disorders"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.9, "level_role": "specific_disease", "classification_axis": "etiology"}, "B2.2": {"id": "B2.2", "label": "Neonatal Onset of Inborn Error of Intestinal Epithelial Function", "level": 2, "status": "closed_for_now", "posterior": 0.0198445807745727, "danger": 0.6, "parent": "B2", "closure_reason": "", "evidence_against": ["Healthy siblings reduce support for inherited metabolic disorders (B2.2/B3). The Down syndrome phenotype is more diagnostically relevant to Hirschsprung disease (B2.1) than metabolic causes."]}, "B1.1": {"id": "B1.1", "label": "Duodenal Atresia (Double Bubble Pattern in Early Neonates)", "level": 2, "status": "closed_for_now", "posterior": 0.0022975926908791345, "danger": 0.7, "parent": "B1", "closure_reason": "", "