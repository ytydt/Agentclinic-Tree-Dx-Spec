anded", "prior": 0.40384615384615385, "posterior": 0.25101887479793267, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Positional chest pain variation (better with leaning forward) is a classic sign of pericardial pathology and moderately supports its inclusion over ischemia which typically does not correlate with position."], "evidence_against": ["Exertional syncope with dynamic outflow obstruction is a key feature of HOCM and provides moderate support for this branch despite potential pericarditis mimicry.", "Without definitive ECG signs (diffuse ST elevation) or pleuritic symptoms, direct support for pericarditis is weakened and would require ECG evaluation."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the chest pain improve with leaning forward?", "Is there a history of recent viral infection or autoimmune disease?"], "requestable_discriminators": ["ECG for diffuse ST elevation", "Inflammatory markers (CRP, ESR)"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.3, "interrupt_relevance": 0.5, "level_role": "family", "classification_axis": "anatomy"}, "B2": {"id": "B2", "label": "Acute Coronary Syndrome with Uncharacterised ECG Abnormality", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.34615384615384615, "posterior": 0.2098312879943535, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Syncope with exertion combined with positional chest discomfort raises suspicion for acute coronary syndrome due to potential ischaemic arrhythmias, but without ST abnormality data cannot be considered strong.", "Preserved S1/S2 suggests low likelihood of acute valvular obstruction but does not exclude HOCM's arrhythmogenic mechanism as primary cause of syncope."], "evidence_against": ["Positional chest pain variation (better with leaning forward) is a classic sign of pericardial pathology and moderately supports its inclusion over ischemia which typically does not correlate with position."], "unresolved_questions": [], "children": ["B2.1", "B2.2", "B2.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the chest pain radiate to left arm/jaw?", "Was the syncope preceded by new-onset diaphoresis/nausea?"], "requestable_discriminators": ["Serial troponin testing", "ECG for regional ST depression/elevation"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "mechanism"}, "B3": {"id": "B3", "label": "Hypertrophic Cardiomyopathy (with dynamic outflow obstruction or arrhythmogenic mechanism)", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.1475376243710298, "danger": 0.75, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Preserved S1/S2 suggests low likelihood of acute valvular obstruction but does not exclude HOCM's arrhythmogenic mechanism as primary cause of syncope.", "The pattern of exertional worsening and syncope raises concern for hemodynamic instability in both HOCM (B3) and unstable angina (B2.2), but does not strongly differentiate between viral pericarditis (B1.1) and ACS due to overlapping features."], "evidence_against": ["Lack of described STEMI signs (ST elevation) does not rule out MI entirely due to potential non-ST elevation MI variants, resulting in a neutral finding."], "unresolved_questions": [], "children": ["B3.1", "B3.2", "B3.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Is there a family history of sudden cardiac death in young persons?", "Does the patient notice exertional syncope or reduced tolerance before this episode?"], "requestable_discriminators": ["Echocardiogram for left ventricular hypertrophy and outflow gradient", "ECG for left ventricular hypertrophy with deep Q waves"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.25, "interrupt_relevance": 0.6, "level_role": "family", "classification_axis": "etiology"}, "B4": {"id": "B4", "label": "Electrolyte Imbalance-related Cardiopulmonary Disturbance", "level": 1, "status": "parked", "posterior": 0.036429043054575255, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Lack of described STEMI signs (ST elevation) does not rule out MI entirely due to potential non-ST elevation MI variants, resulting in a neutral finding."]}, "B1.1": {"id": "B1.1", "label": "Acute Viral/Autoimmune Pericarditis", "parent": "B1", "level": 2, "status": "live", "prior": 0.25240384615384615, "posterior": 0.21515903554108512, "danger": 0.4, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Positional pain improvement with leaning forward is a classic pericardial finding, providing moderate support for viral/autoimmune pericarditis (B1.1) but does not confirm diagnosis due to lack of pleuritic symptoms or definitive ECG changes.", "Positional chest pain is not typical for ACS/NSTEMI (B2.3), but may coexist in patients with concurrent pericardial involvement. This slightly supports for pericardial etiologies."], "evidence_against": ["The pattern of exertional worsening and syncope raises concern for hemodynamic instability in both HOCM (B3) and unstable angina (B2.2), but does not strongly differentiate between viral pericarditis (B1.1) and ACS due to overlapping features."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["History of recent viral infection (e.g., coxsackievirus)"], "requestable_discriminators": ["ECG for diffuse ST elevation", "CRP/ESR for inflammation"], "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.25, "interrupt_relevance": 0.3, "level_role": "specific_disease", "classification_axis": "etiology"}, "B1.2": {"id": "B1.2", "label": "Infectious Pericarditis (Bacterial/Tuberculous)", "parent": "B1", "level": 2, "status": "reopened", "prior": 0.10096153846153849, "posterior": 0.023906559504565023, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": ["Normal S1/S2 without valvular abnormalities slightly weakens the likelihood of bacterial/tuberculous pericarditis (B1.2) compared to viral pericarditis (B1.1), but this is a low-power finding based on EBM metrics (LR± near 1.0).", "The absence of systemic inflammatory signs (e.g., fever) weakens bacterial/tuberculous pericarditis (B1.2), which often presents with more overt systemic symptoms, but this remains clinically plausible."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Signs of sepsis (e.g., high fever, leukocytosis)"], "requestable_discriminators": ["Blood cultures", "PCR for pericardial fluid analysis"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.3, "interrupt_relevance": 0.7, "level_role": "specific_disease", "classification_axis": "etiology"}, "B1.3": {"id": "B1.3", "label": "Autoimmune Pericarditis (e.g., SLE/Sjogren's related)", "level": 2, "status": "closed_for_now", "posterior": 0.011953279752282511, "danger": 0.5, "parent": "B1", "closure_reason": "", "evidence_against": ["The pattern of exertional worsening and syncope raises concern for hemodynamic instability in both HOCM (B3) and unstable angina (B2.2), but does not strongly differentiate between viral pericarditis (B1.1) and ACS due to overlapping features."]}, "B2.1": {"id": "B2.1", "label": "ST-Elevation Myocardial Infarction (STEMI)", "parent": "B2", "level": 2, "status": "reopened", "prior": 0.13846153846153847, "posterior": 0.03278613874911774, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": ["Absence of prior angina reduces likelihood of classic STEMI (B2.1) but makes atypical ACS variants (B2.2/B2.3) more plausible, particularly NSTEMI given the normal ECG described in the vignette.", "Positional chest pain variation is atypical for STEMI (B2.1), which is typically non-positional, but could be seen atypical ACS cases or in those with concurrent pericardial effusion."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Does the chest pain radiate to left arm/jaw?", "Was the syncope preceded by new-onset diaphoresis/nausea?"], "requestable_discriminators": ["ECG for regional ST elevation", "Serial troponin testing"], "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.8, "level_role": "specific_disease", "classification_axis": "management_pathway"}, "B2.2": {"id": "B2.2", "label": "Non-ST Elevation Myocardial Infarction (NSTEMI) or Unstable Angina", "parent": "B2", "level": 2, "status": "live", "prior": 0.12115384615384614, "posterior": 0.10327633705972085, "danger": 0.85, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["The pattern of exertional worsening and syncope raises concern for hemodynamic instability in both HOCM (B3) and unstable angina (B2.2), but does not strongly differentiate between viral pericarditis (B1.1) and ACS due to overlapping features.", "Absence of prior angina reduces likelihood of classic STEMI (B2.1) but makes atypical ACS variants (B2.2/B2.3) more plausible, particularly NSTEMI given the normal ECG described in the vignette."], "evidence_against": ["Absence of ECG ST changes reduces support for NSTEMI (B2.2), but patients with chronic hypertension may exhibit minimal or atypical ST changes, maintaining low-to-moderate plausibility."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Is pain relieved by rest/nitroglycerin?", "History of stable angina pre-attack?"], "requestable_discriminators": ["ECG for ST depression/T-wave inversion", "Serial troponin for elevation"], "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.35, "interrupt_relevance": 0.6, "level_role": "disease_class", "classification_axis": "management_pathway"}, "B2.3": {"id": "B2.3", "label": "Acute Coronary Syndrome with Atypical/Non-STEMI NSTEMI ECG", "parent": "B2", "level": 2, "status": "live", "prior": 0.08653846153846154, "posterior": 0.0737688121855149, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Absence of prior angina reduces likelihood of classic STEMI (B2.1) but makes atypical ACS variants (B2.2/B2.3) more plausible, particularly NSTEMI given the normal ECG described in the vignette.", "Absence of ECG ST changes reduces support for NSTEMI (B2.2), but patients with chronic hypertension may exhibit minimal or atypical ST changes, maintaining low-to-moderate plausibility."], "evidence_against": ["Positional chest pain is not typical for ACS/NSTEMI (B2.3), but may coexist in patients with concurrent pericardial involvement. This slightly supports for pericardial etiologies."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Is there prior history of MI or coronary artery disease?", "Are there ECG changes in non-ischaemic patterns (e.g., T-wave inversions without ST shifts)?"], "requestable_discriminators": ["Coronary angiography for obstructive CAD", "Repeat ECG to capture evolving ischaemia"], "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.2, "interrupt_relevance": 0.5, "level_role": "specific_disease", "classification_axis": "test_pathway"}, "B3.1": {"id": "B3.1", "label": "Obstructive Hypertrophic Cardiomyopathy with Left Ventricular Outflow Tract Gradient (Classic HOCM Variant)", "parent": "B3", "level": 2, "status": "live", "prior": 0.09209924430433981, "posterior": 0.09209924430433981