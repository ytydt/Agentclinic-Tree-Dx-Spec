", "Hyperparathyroidism: hypercalcemia is present, but insufficient evidence (e.g., PTH levels) to prioritize as primary mechanism", "Chronic myeloid leukemia (CML): high WBC with normal differential is atypical for CML; requires further testing for confirmation", "Malignancy with bone marrow infiltration: constitutional symptoms and lab findings are consistent, but not definitively localized"], "alarm_features": ["Unintentional weight loss", "Hypercalcemia", "Elevated white blood cell count"]}, "branches": {"B1": {"id": "B1", "label": "Reactive / Non-malignant Leukocytosis", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.21815008726003488, "posterior": 0.21815008726003488, "danger": 0.3, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.5, "interrupt_relevance": 0.3, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B2": {"id": "B2", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.40314136125654443, "posterior": 0.40314136125654443, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 3.0, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute myeloid leukemia", "myelodysplastic syndrome with excess blasts", "chronic myeloid leukemia in blast crisis"]}, "B3": {"id": "B3", "label": "Chronic Myeloproliferative Neoplasm (chronic/accelerated phase)", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.23036649214659685, "posterior": 0.23036649214659685, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.5, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["chronic myeloid leukemia", "polycythemia vera", "essential thrombocythemia", "primary myelofibrosis"]}, "B4": {"id": "B4", "label": "Lymphoid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.06108202443280976, "posterior": 0.06108202443280976, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 3.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.7, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute lymphoblastic leukemia", "lymphoblastic lymphoma"]}, "B5": {"id": "B5", "label": "Plasma Cell / Lymphoproliferative Disorder", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.08726003490401396, "posterior": 0.08726003490401396, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.5, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}}, "frontier": ["B1", "B2", "B3", "B4", "B5"], "other_mass": 0.0, "pending_results": [], "actions_taken": [], "differential_history": [], "deliberation": {}, "interrupt": {"active": false, "reason": "", "required_actions": []}, "termination": {"ready_to_stop": false, "termination_type": "continue", "reason": ""}, "turn_budget_used": 0, "estimated_remaining_value": 0.0, "max_turn_