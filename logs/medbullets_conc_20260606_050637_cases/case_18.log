tory"], "excluded_candidates": ["Acute Cholecystitis: Classic RUQ pain but systemic instability suggests more severe progression", "Alcoholic Hepatitis: Chronic liver pathology inconsistent with sudden acute presentation", "Exercise-related muscle strain: Would present with non-localized pain and no hemodynamic compromise", "Ovarian torsion: Possible but lacks specific torsion findings (e.g., adnexal tenderness) in this presentation"], "alarm_features": ["Hemodynamic instability (hypotension, tachycardia)"]}, "branches": {"B1": {"id": "B1", "label": "Obstetric/Reproductive Tract Emergency", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0971348212089717, "posterior": 0.14431160912306712, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["β-hCG testing prioritized for obstetric emergency evaluation despite contraceptive use, indicating hemodynamic instability warrants ruling out pregnancy-relate…"], "evidence_against": [], "unresolved_questions": [], "children": ["B1.1", "B1.2"], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 1.0, "level_role": "family", "classification_axis": "mechanism"}, "B2": {"id": "B2", "label": "Acute Hepatic/Vascular Liver Pathology", "level": 1, "status": "parked", "posterior": 0.381, "danger": 0.85, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Lack of ascites/hepatomegaly significantly weakens Budd-Chiari syndrome (B2) as a viable alternative despite prior consideration."]}, "B3": {"id": "B3", "label": "Acute Pancreatic/Visceral Inflammation", "level": 1, "status": "closed_for_now", "posterior": 0.019, "danger": 0.8, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Localized RUQ pain and absence of epigastric radiation provide weak disconfirming evidence against alcoholic pancreatitis (B3) compared to localized biliary pa…"]}, "B4": {"id": "B4", "label": "Biliary Tract Obstruction", 