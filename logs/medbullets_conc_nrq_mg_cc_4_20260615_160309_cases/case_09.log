 confounders)"], "excluded_candidates": ["Acute Infection with Constitutional Symptoms: Leukocytosis could be due to recent cold, but weight loss and chronic fatigue suggest a more persistent process", "Chronic Inflammatory Condition with Systemic Involvement: Elevated alkaline phosphatase might indicate liver/bone disease, but malignancy remains a higher-priority differential with constitutional symptoms", "Myeloproliferative Disorder: Elevated WBC and constitutional symptoms are nonspecific, but lack of clonal markers in differential reduces urgency"], "alarm_features": ["Constitutional symptoms (weight loss, fatigue)", "Abdominal pain with systemic abnormalities"]}, "branches": {"B3": {"id": "B3", "label": "Chronic Myeloproliferative Neoplasm (chronic/accelerated phase)", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.661143731441028, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The chronic constitutional symptoms argue against a leukemoid reaction, which is typically an acute response to infection or inflammation."], "evidence_against": ["The patient's recent cold could suggest a leukemoid reaction, but the chronic constitutional symptoms argue against this diagnosis."], "unresolved_questions": [], "children": ["B3.1", "B3.2", "B3.3", "B3.4"], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.7, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["chronic myeloid leukemia", "polycythemia vera", "essential thrombocythemia", "primary myelofibrosis"]}, "B4": {"id": "B4", "label": "Lymphoproliferative / Plasma Cell Disorder", "level": 1, "status": "parked", "posterior": 0.151, "danger": 0.6, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The elevated LAP suggests a myeloid process, making lymphoproliferative disorders less likely."]}, "B5": {"id": "B5", "label": "Re