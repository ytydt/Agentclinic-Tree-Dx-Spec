a or blast predomi…"}, "action_intents": [{"t": 1, "intent": "confirm"}, {"t": 2, "intent": "confirm"}, {"t": 2, "intent": "refute"}, {"t": 3, "intent": "confirm"}, {"t": 3, "intent": "refute"}, {"t": 3, "intent": "broaden"}], "considered_alternatives": ["B4"]}}
