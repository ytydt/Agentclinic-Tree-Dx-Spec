ce likelihood", "Paraneoplastic neurological syndrome: considered but deferred pending imaging/localizing evidence"], "alarm_features": ["Constitutional symptoms (fever, weight loss, night sweats)", "Pancytopenia with blasts on CBC"]}, "branches": {"B1": {"id": "B1", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.4726947179946284, "posterior": 0.09600460641450512, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Peripheral blood blasts without lymphadenopathy reduce the likelihood of acute lymphoblastic leukemia (ALL), favoring myeloid origins."], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.7, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute myeloid leukemia", "myelodysplastic syndrome with excess blasts", "chronic myeloid leukemia in blast crisis"]}, "B2": {"id": "B2", "label": "Lymphoid Neoplasm with Increased Blasts", "level": 1, "status": "parked", "posterior": 0.248, "danger": 0.75, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Peripheral blood blasts without lymphadenopathy reduce the likelihood of acute lymphoblastic leukemia (ALL), favoring myeloid origins."]}, "B3": {"id": "B3", "label": "Chronic Myeloproliferative Neoplasm", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.2363473589973142, "posterior": 0.5289277957697983, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The abrupt onset of symptoms and high blast count suggest CML in blast crisis rather than stable chronic myeloproliferative phases."], "evidence_against": ["Absence of documented prior MPN weakens the case for chronic myeloid disorders but does not exclude blast crisis as a de novo presentation."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.5, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["chronic myeloid leukemia", "polycythemia vera", "essential thrombocythemia", "primary myelofibrosis"]}, "B4": {"id": "B4", "label": "Lymphoproliferative / Plasma Cell Disorder", "level": 1, "status": "closed_for_now", "posterior": 0.027, "danger": 0.6, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Blasts in peripheral blood and pancytopenia are inconsistent with plasma cell disorders like multiple myeloma."]}, "B5": {"id": "B5", "label": "Reactive / Non-malignant Leukocytosis", "level": 1, "status": "parked", "posterior": 0.1, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": []}}, "frontier": ["B1", "B3"], "other_mass": 0.0, "pending_results": [], "actions_taken": [{"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Do the peripheral blood blast morphology and absence of lymphadenopathy make acute lymphoblastic leukemia (ALL) less likely than myeloid neoplasms?", "summary": "Peripheral blood blasts without lymphadenopathy reduce the likelihood of acute lymphoblastic leukemia (ALL), favoring myeloid origins."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the abrupt onset of constitutional symptoms and 35% blasts in peripheral blood favor CML in blast crisis over typical chronic myeloproliferative phases?", "summary": "The abrupt onset of symptoms and high blast count suggest CML in blast crisis rather than stable chronic myeloproliferative phases."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the absence of bone marrow fibrosis or chronic phase features (e.g., splenomegaly) in the presentation argue against CML in blast crisis as a cause of myeloid blast increase?", "summary": "Lack of splenomegaly or fibrosis slightly reduces suspicion for CML in blast crisis compared to other myeloid