active/non-malignant crisis hypothesis."]}, "B1.1": {"id": "B1.1", "label": "Acute Aortic Stenosis with Hypertensive Crisis", "parent": "B1", "level": 2, "status": "live", "prior": 0.32768647281921615, "posterior": 0.32768647281921615, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.9, "level_role": "disease_class", "classification_axis": "mechanism", "representative_diseases": []}, "B1.2": {"id": "B1.2", "label": "Acute Myocardial Infarction with Hypertensive Presentation", "parent": "B1", "level": 2, "status": "live", "prior": 0.16384323640960807, "posterior": 0.16384323640960807, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.3, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.85, "level_role": "specific_disease", "classification_axis": "management_pathway", "representative_diseases": []}, "B1.3": {"id": "B1.3", "label": "Hypertensive Crisis in Dilated Cardiomyopathy", "parent": "B1", "level": 2, "status": "live", "prior": 0.12288242730720604, "posterior": 0.12288242730720604, "danger": 0.75, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.2, "diagnosis_commitment_gain": 0.65, "interrupt_relevance": 0.8, "level_role": "disease_class", "classification_axis": "urgency", "representative_diseases": []}}, "frontier": ["B1.1", "B1.2", "B1.3", "B3"], "other_mass": 0.0, "pending_results": [], "actions_taken": [{"t": 2, "type": "ANALYZE_VIGNETTE", "content": "Would findings of asymmetric blood pressure 