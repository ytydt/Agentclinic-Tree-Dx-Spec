: ["Dermoscopy", "Biopsy with vascular immunostaining"], "turn_cost_to_refine": 3, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.1, "level_role": "family", "classification_axis": "mechanism"}, "B3": {"id": "B3", "label": "Hereditary Cancer Syndrome (Skin/Non-skin Related)", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.14173228346456693, "posterior": 0.07107601184600199, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Multigenerational cancer pattern raises suspicion for syndromic causes like xeroderma pigmentosum, though evidence remains weak for definitive hereditary linkage"], "evidence_against": ["Recent close contact with a grandfather having vesicular lesions increases the probability of viral rash transmission (HSV/VZV) rather than de novo malignancy", "Hereditary cancer syndrome (B3) weakly contradicted by stable vitals, which are more typical of acute infections than primary skin malignancy."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Family history pattern analysis (multigenerational skin vs. other cancers)", "Personal history of precancerous lesions"], "requestable_discriminators": ["Genetic counseling/panel testing", "Screening for Lynch syndrome or BRCA alterations"], "turn_cost_to_refine": 4, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.7, "level_role": "family", "classification_axis": "risk_context"}, "B4": {"id": "B4", "label": "Reactive/Inflammatory Dermatosis", "level": 1, "status": "closed_for_now", "posterior": 0.0246791707798618, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Mild attenuation of B1 plausibility due to absence of systemic symptoms, but asymptomatic shedding preserves viral considerations."]}, "B5": {"id": "B5", "label": "Autoimmune/Connective Tissue Disease with Vesicular Manifestations", "level": 1, "status": "parked", "posterior