tory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Recent close contact with a grandfather having vesicular lesions increases the probability of viral rash transmission (HSV/VZV) rather than de novo malignancy", "Recent familial viral exposure most strongly supports vesicular viral infection (B1) over hereditary cancer, but doesn't eliminate malignant or hereditary considerations."], "evidence_against": ["Lack of fever or systemic symptoms reduces but does not eliminate viral considerations; asymptomatic viral shedding remains possible", "Mild attenuation of B1 plausibility due to absence of systemic symptoms, but asymptomatic shedding preserves viral considerations."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Recent family history of vesicular lesions", "Presence of systemic viral symptoms (e.g., fever, viral marker trends)"], "requestable_discriminators": ["PCR for HSV/VZV", "Serologies for viral exanthemata"], "turn_cost_to_refine": 2, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.5, "level_role": "family", "classification_axis": "etiology"}, "B2": {"id": "B2", "label": "Benign Vascular Proliferation", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.4893123729244916, "danger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The complete absence of vasculitis markers (fever, nuchal rigidity) and stability of vitals provide moderate-to-strong support for B2 while weakly excluding malignant vascular proliferation.", "The patient's normal vitals and lack of dermatomal distribution reduce the likelihood of VZV compared to HSV-1/2, moderately support benign vascular proliferation (B2) over infectious/malignant processes, and provide weak support against autoimmune blistering disease. The absence of inflammatory markers and systemic symptoms maintains a lower probability for VZV and malignant vascular involvement."], "evidence_against": ["The viral exposure context moderately supports HSV-1/2 (B1.1) as a likely explanation, though absence of atypical HSV features in the vignette prevents stronger evidence for this specific subtype.", "Normal vitals alone do not exclude hereditary cancer syndromes as a cutaneous manifestation, but their absence reduces B3's plausibility by >49% based on LR reference data."], "unresolved_questions": [], "children": ["B2.1", "B2.2", "B2.3"], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Family history of skin cancer monitoring considerations", "Lesion growth patterns"], "requestable_discriminators": ["Dermoscopy", "Biopsy with vascular immunostaining"], "turn_cost_to_refine": 3, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.1, "level_role": "family", "classification_axis": "mechanism"}, "B3": {"id": "B3", "label": "Hereditary Cancer Syndrome (Skin/Non-skin Related)", "level": 1, "status": "closed_for_now", "posterior": 0.006712103880994399, "danger": 0.9, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The patient's normal vitals and lack of dermatomal distribution reduce the likelihood of VZV compared to HSV-1/2, moderately support benign vascular proliferation (B2) over infectious/malignant processes, and provide weak support against autoimmune blistering disease. The absence of inflammatory markers and systemic symptoms maintains a lower probability for VZV and malignant vascular involvement."]}, "B4": {"id": "B4", "label": "Reactive/Inflammatory Dermatosis", "level": 1, "status": "closed_for_now", "posterior": 0.009322366501381109, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Mild attenuation of B1 plausibility due to absence of systemic symptoms, but asymptomatic shedding preserves viral considerations."]}, "B5": {"id": "B5", "label": "Autoimmune/Connective Tissue Disease with Vesicular Manifestations", "level": 1, "status": "closed_for_now", "posterior": 0.004661183250690554, "danger": 0.8, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The patient's normal vitals and lack of dermatomal distribution reduce the likelihood of VZV compared to HSV-1/2, moderately support benign vascular proliferation (B2) over infectious/malignant processes, and provide weak support against autoimmune blistering disease. The absence of inflammatory markers and systemic symptoms maintains a lower probability for VZV and malignant vascular involvement."]}, "B1.1": {"id": "B1.1", "label": "Vesicular Herpes Simplex Virus Infection (HSV-1/HSV-2)", "parent": "B1", "level": 2, "status": "live", "prior": 0.1966205008563376, "posterior": 0.24465618646224582, "danger": 0.4, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["The viral exposure context moderately supports HSV-1/2 (B1.1) as a likely explanation, though absence of atypical HSV features in the vignette prevents stronger evidence for this specific subtype.", "The patient's normal vitals and lack of dermatomal distribution reduce the likelihood of VZV compared to HSV-1/2, moderately support benign vascular proliferation (B2) over infectious/malignant processes, and provide weak support against autoimmune blistering disease. The absence of inflammatory markers and systemic symptoms maintains a lower probability for VZV and malignant vascular involvement."], "evidence_against": ["Stable vitals (E6-E10) suggest asymptomatic viral shedding rather than active systemic viral infection, supporting B1.3 while moderately excluding B4 as a reactive/acute process.", "The complete absence of vasculitis markers (fever, nuchal rigidity) and stability of vitals provide moderate-to-strong support for B2 while weakly excluding malignant vascular proliferation."], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Lesion location (e.g., clustered perioral or genital vesicles)", "History of similar outbreaks"], "requestable_discriminators": ["PCR for HSV DNA", "Tzanck smear showing multinucleated giant cells (less specific)"], "turn_cost_to_refine": 2, "diagnosis_commitment_gain": 0.5, "interrupt_relevance": 0.3, "level_role": "specific_disease", "classification_axis": "etiology"}, "B1.2": {"id": "B1.2", "label": "Varicella-Zoster Virus Infection (VZV) or Chickenpox/Shingles", "level": 2, "status": "parked", "posterior": 0.028316688247945115, "danger": 0.7, "parent": "B1", "closure_reason": "", "evidence_against": ["The patient's normal vitals and lack of dermatomal distribution reduce the likelihood of VZV compared to HSV-1/2, moderately support benign vascular proliferation (B2) over infectious/malignant processes, and provide weak support against autoimmune blistering disease. The absence of inflammatory markers and systemic symptoms maintains a lower probability for VZV and malignant vascular involvement."]}, "B1.3": {"id": "B1.3", "label": "Other Viral Etiologies (e.g., HHV-6/7, Coxsackievirus, Asymptomatic Shedding)", "level": 2, "status": "closed_for_now", "posterior": 0.010873608287210925, "danger": 0.6, "parent": "B1", "closure_reason": "", "evidence_against": ["The patient's normal vitals and lack of dermatomal distribution reduce the likelihood of VZV compared to HSV-1/2, moderately support benign vascular proliferation (B2) over infectious/malignant processes, and provide weak support against autoimmune blistering disease. The absence of inflammatory markers and systemic symptoms maintains a lower probability for VZV and malignant vascular involvement."]}, "B2.1": {"id": "B2.1", "label": "Acquired Cavernous Hemangioma", "parent": "B2", "level": 2, "status": "live", "prior": 0.24465618646224582, "posterior": 0.24465618646224582, "danger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Lesion blanching with pressure", "History of childhood hemangioma (to differentiate congenital types)", "Pain/discomfort associated with lesion"], "requestable_discriminators": ["Doppler ultrasound for vascular flow patterns", "Skin biopsy with CD31/CD34 vascular staining", "Dermoscopy for lobular vascular architecture"], "turn_cost_to_refine": 2, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.05, "level_role": "specific_disease", "classification_axis": "etiology"}, "B2.2": {"id": "B2.2", "label": "Pyogenic Granuloma (Acquired Vascular Hamartoma)", "parent": "B2", "level": 2, "status": "live", "prior": 0.17125933052357206, "posterior": 0.17125933052357206, "danger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Rapid growth over <4 weeks consistent with pyogenic granuloma", "History of minor trauma at the lesion site", "Lesion size exceeding typical epidermal edema patterns"], "requestable_discriminators": ["Histopathology for granulation tissue architecture", "In-office shave biopsy for expedited diagnosis", "Tzanck smear (to exclude vesiculobullous viral etiologies)"], "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.55, "interrupt_relevance": 0.1, "level_role": "specific_disease", "classification_axis": "anatomy"}, "B2.3": {"id": "B2.3", "label": "Angiokeratoma (Hereditary or Non-specific Variant)", "parent": "B2", "level": 2, "status": "live", "prior": 0.07339685593867375, "posterior": 0.07339685593867375, "danger": 0.2, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "reopen_triggers": [], "askable_discriminators": ["Lesion morphology: pinpoin