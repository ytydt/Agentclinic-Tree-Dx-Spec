      "label": "Subacute Unilateral Upper-Limb Neurological Deficit with Mechanical Alarm Signs",
      "time_course": "subacute",
      "severity": "unspecified",
      "confidence": 0.8,
      "supporting_facts": [
        "pain and weakness in the right shoulder after physical activity",
        "prominent weakness of external rotation of the right upper extremity",
