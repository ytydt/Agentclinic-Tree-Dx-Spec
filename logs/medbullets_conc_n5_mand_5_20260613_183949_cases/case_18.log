, "Daily alcohol consumption (5 standard drinks)", "Current use of oral contraceptive pills"], "excluded_candidates": ["Acute cholecystitis: Unlikely as primary mechanism due to lack of fever, jaundice, or biliary colic pattern", "Exercise-induced musculoskeletal injury: Could explain sudden pain exacerbation but insufficient to explain shock", "Alcohol-induced acute pancreatitis: Atypical for right upper quadrant localization and shock presentation", "Gastritis/peptic ulcer disease: Would not typically cause hemodynamic instability"], "alarm_features": ["Hypotension with tachycardia (shock)", "Severe localized right upper quadrant pain (potential intra-abdominal source)", "Unprotected sexual activity with prior gonococcal infection (risk for pelvic sepsis)"]}, "branches": {"B1": {"id": "B1", "label": "Gynecologic / Pelvic Source of Shock", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.4761904761904762, "danger": 1.0, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Patient's sexual history and prior gonococcal infection weakly support a pelvic/gynecologic source of shock, but the RUQ localization argues against this."], "evidence_against": ["RUQ pain localization weakly argues against pelvic source of shock, which typically presents with lower abdomen/pelvic pain."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.5, "interrupt_relevance": 1.0, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B2": {"id": "B2", "label": "Hepatic / Hepatobiliary Vascular Source of Shock", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.15, "posterior": 0.2857142857142857, "danger": 1.0, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Alcohol use and OC pills provide weak support for hepatic/vascular shock via thrombosis/coagulopathy, though physical exam findings are inconsistent with typic…"], "evidence_against": ["Absence of hepatomegaly/ascites weakly argues against hepatic/vascular shock explanations like Budd-Chiari syndrome."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 1.0, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B3": {"id": "B3", "label": "Biliary Obstruction with Shock", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.1, "posterior": 0.19047619047619047, "danger": 1.0, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["RUQ pain provides weak support for biliary obstruction, but lack of fever/jaundice (core features of cholangitis) weakly argues against this explanation."], "evidence_against": ["Absence of fever/jaundice (hallmarks of cholangitis) moderately argues against biliary obstruction with septic shock."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.35, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B4": {"id": "B4", "label": "Pancreatic Source of Shock", "level": 1, "status": "closed_for_now", "posterior": 0.048, "danger": 1.0, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Absence of classic pancreatic signs and normal enzyme profile strongly argues against acute pancreatitis as a shock source."]}, "B1.1": {"id": "B1.1", "label": "Ectopic Implantation (Trophoblastic Source)", "parent": "B1", "level": 2, "status": "live", "prior": 0.15873015873015875, "posterior": 0.15873015873015875, "danger": 1.0, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 1.0, "level_role": "specific_disease", "classification_axis": "etiology", "representative_diseases": []}, "B1.2": {"id": "B1.2", "label": "Pelvic Inflammatory Disease with Septic Shock", "parent": "B1", "level": 2, "status": "live", "prior": 0.21164021164021166, "posterior": 0.21164021164021166, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.8, "diagnosis_commitment_gain": 0.45, "interrupt_relevance": 0.95, "level_role": "specific_disease", "classification_axis": "mechanism", "representative_diseases": []}, "B1.3": {"id": "B1.3", "label": "Ovarian Torsion with Hemorrhagic Shock", "parent": "B1", "level": 2, "status": "live", "prior": 0.10582010582010583, "posterior": 0.10582010582010583, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.2, "diagnosis_commitment_gain": 0.4, "interrupt_relevance": 0.9, "level_role": "specific_disease", "classification_axis": "anatomy", "representative_diseases": []}}, "frontier": ["B1.1", "B1.2", "B1.3", "B2", "B3"], "other_mass": 0.0, "pending_results": [], "actions_taken": [{"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the patient's daily alcohol consumption (5 standard drinks) and use of oral contraceptive pills support a hepatic/vascular source of shock through potential mechanisms of coagulopathy or hepatic…", "summary": "Alcohol use and OC pills provide weak support for hepatic/vascular shock via thrombosis/coagulopathy, though physical exam findings are inconsistent with typical Budd-Chiari syndrome."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the patient's right upper quadrant pain and hypotension