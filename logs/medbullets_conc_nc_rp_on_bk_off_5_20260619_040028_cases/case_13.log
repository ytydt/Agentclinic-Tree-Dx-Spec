, "level": 1, "status": "expanded", "prior": 0.5581395348837209, "posterior": 0.5896294865925235, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["Systemic symptoms like abdominal pain and diarrhea suggest a broader syndrome (B1/B5) rather than simple metabolic/endocrine dysfunction (B2)."], "evidence_against": ["Lack of prior neoplastic history moderately weakens B1 but does not exclude it given acute presentation."], "unresolved_questions": [], "children": ["B1.1", "B1.2", "B1.3"], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.6, "level_role": "family", "classification_axis": "etiology", "representative_diseases": []}, "B2": {"id": "B2", "label": "Metabolic/Endocrine Disorder with Hyperglycemia and Cutaneous Involvement", "level": 1, "status": "closed_for_now", "posterior": 0.02, "danger": 0.5, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Extreme hyperglycemia without insulin deficiency weakens metabolic/endocrine hypotheses and supports neoplastic causes."]}, "B3": {"id": "B3", "label": "Autoimmune/Inflammatory Condition with Hyperglycemia and Systemic Symptoms", "level": 1, "status": "parked", "posterior": 0.043, "danger": 0.5, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Systemic symptoms like abdominal pain and diarrhea suggest a broader syndrome (B1/B5) rather than simple metabolic/endocrine dysfunction (B2)."]}, "B4": {"id": "B4", "label": "Infectious/Reactive Multisystem Syndrome with Hyperglycemia and Rash", "level": 1, "status": "parked", "posterior": 0.024, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The lack of fever and presence of extreme hyperglycemia make infectious/reactive syndromes less likely."]}, "B5": {"id": "B5", "label": "Other Systemic Conditions with Hyperglycemia and Cutaneous Symptoms", "level": 1, "status": "parked", "posterior": 0.013, "danger": 0.2, "p