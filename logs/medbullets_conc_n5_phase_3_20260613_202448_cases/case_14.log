nce birth"], "excluded_candidates": ["Cystic Fibrosis: Normal bowel movements and weight gain might reduce likelihood, but chronic airway dilation and recurrent infections remain relevant", "Primary Ciliary Dyskinesia: Not ruled out due to chronic respiratory symptoms and sinus issues consistent with this diagnosis", "Vasovagal Syncope: No evidence of syncope in this case", "Orthostatic Hypotension: Vital signs do not clearly support this mechanism"], "alarm_features": ["Persistent multisystem symptoms (respiratory + cardiac) since birth", "Congenital tricuspid stenosis", "Airway dilation on MRI"]}, "branches": {"B1": {"id": "B1", "label": "Primary Ciliary Dyskinesia Spectrum", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.45329888077576336, "posterior": 0.45329888077576336, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.6, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B2": {"id": "B2", "label": "Cystic Fibrosis Spectrum", "level": 1, "status": "parked", "posterior": 0.242, "danger": 0.8, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B3": {"id": "B3", "label": "Congenital Immunodeficiency with Pulmonary Manifestations", "level": 1, "status": "parked", "posterior": 0.242, "danger": 0.5, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B4": {"id": "B4", "label": "Allergic/Inflammatory Airway Disorders", "level": 1, "status": "parked", "posterior": 0.063, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B5": {"id": "B5", "label": "Congenital Cardiopulmonary Syndromes", "level": 1, "status": "parked", "posterior": 0.0, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": []}}, "frontier": ["B1", "B2", "B3", "B4", "B5"], "other_mass": 0.0, "pending_results": [], "actions_taken": [{"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the chronic airway dilation on MRI and recurrent frontal sinusitis/cough since birth (per primekg evidence) support the diagnosis of Primary Ciliary Dyskinesia Spectrum over Cystic Fibrosis?", "summary": "Chronic airway dilation and recurrent sinusitis/cough are more characteristic of Primary Ciliary Dyskinesia than Cystic Fibrosis, especially with normal growth parameters. This provides moderate support for PCD."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the presence of tricuspid stenosis (congenital cardiac anomaly) and airway dilation on MRI (per primekg evidence) strongly favor Cystic Fibrosis Spectrum as an autosomal recessive disease with m…", "summary": "Tricuspid stenosis is a congenital cardiac anomaly not typically associated with Cystic Fibrosis. This reduces CF Spectrum's likelihood moderately."}, {"t": 1, "type": "ANALYZE_VIGNETTE", "content": "Does the patient's appropriate weight gain and normal bowel movements (per guardians) argue against Cystic Fibrosis Spectrum despite the chronic airway dilation and recurrent infections?", "summary": "Normal growth and bowel movements are inconsistent with pancreatic insufficiency in Cystic Fibrosis. This provides moderate against evidence for CF Spectrum."}], "differential_history": [{"top": [["B1", 0.554], ["B1.1", 0.277], ["B1.2", 0.185]]}], "deliberation": {}, "interrupt": {"active": false, "reason": "", "required_actions": []}, "termination": {"ready_to_stop": false, "termination_type": "continue", "reason": "Leading hypothesis (Primary Ciliary Dyskinesia Spectrum) has posterior 0.554 (<0.75) and dangerous alternative (Cystic Fibrosis, posterior 0.185, danger 0.8) remains unresolved. Subtypes under B1 (B1.1-1.3) require further differentiation to confirm management-relevant features."}, "turn_budget_used": 1, "estimated_remaining_value": 0.57, "max_tu