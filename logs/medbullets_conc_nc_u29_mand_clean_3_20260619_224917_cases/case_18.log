gh these factors are not pathogn…"], "evidence_against": ["Classic Budd-Chiari signs (jaundice, ascites, hepatomegaly) are absent, which moderately weakens B2 but does not exclude it due to potential atypical presentat…"], "unresolved_questions": [], "children": ["B2.1", "B2.2", "B2.3"], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.7, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B3": {"id": "B3", "label": "Biliary Obstruction", "level": 1, "status": "closed_for_now", "posterior": 0.048, "danger": 0.6, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B4": {"id": "B4", "label": "Pancreatic Acute Process", "level": 1, "status": "parked", "posterior": 0.016, "danger": 0.7, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The absence of fever, leukocytosis, and elevated enzymes makes a pancreatic acute process (B4) unlikely despite alcohol use, leading to moderate reduction in l…"]}, "B1.1": {"id": "B1.1", "label": "Ruptured Ectopic Pregnancy (β-hCG positive)", "parent": "B1", "level": 2, "status": "live", "prior": 0.3308961318836606, "posterior": 0.3308961318836606, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.2, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.9, "level_role": "specific_disease", "classification_axis": "etiology", "representative_diseases": []}, "B1.2": {"id": "B1.2", "label": "Ovarian Torsion with Hemorrhage (β-hCG negative)", "parent": "B1", "level": 2, "status": "live", "prior": 0.19853767913019638, "posterior": 0.19853767913019638, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "t