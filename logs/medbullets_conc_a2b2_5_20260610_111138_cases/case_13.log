rovide moderate support for an endocrine tumor (B1), thou…"], "evidence_against": ["Extreme hyperglycaemia with multisystem symptoms moderately reduces the likelihood of metabolic syndrome (B4) as the primary mechanism, though obesity still pr…"], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.3, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B5": {"id": "B5", "label": "Reactive Hyperglycemia", "level": 1, "status": "parked", "posterior": 0.026, "danger": 0.2, "parent": "ROOT", "closure_reason": "", "evidence_against": ["The presence of a painful rash and absence of tumor markers or abdominal mass moderately weakens endocrine tumor (B1) as the primary explanation."]}, "B1.1": {"id": "B1.1", "label": "Glucagonoma (Alpha Cell Tumor)", "parent": "B1", "level": 2, "status": "live", "prior": 0.32866365657891344, "posterior": 0.32866365657891344, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.3, "interrupt_relevance": 0.6, "level_role": "disease_class", "classification_axis": "etiology", "representative_diseases": []}, "B1.2": {"id": "B1.2", "label": "VIPoma (Enteroglucagon Cell Tumor)", "parent": "B1", "level": 2, "status": "live", "prior": 0.24649774243418504, "posterior": 0.24649774243418504, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.25, "interrupt_relevance": 0.5, "level_role": "disease_class", "classification_axis": "etiology", "representative_diseases": []}, "B1.3": {"id": "B1.3", "label": "Pheochromoc