cks specific serologic evidence", "Diabetic ketoacidosis: inconsistent with normal glucose and absence of metabolic derangements"], "alarm_features": ["Constitutional symptoms (weight loss, night sweats, fever)", "Pancytopenia with blasts indicating possible leukemia"]}, "branches": {"B1": {"id": "B1", "label": "Myeloid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.46451612903225814, "posterior": 0.06421228845071288, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Peripheral blasts are more characteristic of myeloid than lymphoid lineage, providing moderate support for myeloid neoplasm."], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute myeloid leukemia", "myelodysplastic syndrome with excess blasts", "chronic myeloid leukemia in blast crisis"]}, "B2": {"id": "B2", "label": "Lymphoid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.12316715542521994, "posterior": 0.06843002970131104, "danger": 0.7, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": ["Peripheral blasts are more characteristic of myeloid than lymphoid lineage, providing moderate support for myeloid neoplasm."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.6, "interrupt_relevance": 0.7, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute lymphoblastic leukemia", "lymphoblastic lymphoma"]}, "B3": {"id": "B3", "label": "Chronic Myeloproliferative Neoplasm", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.3483870967741936, "posterior": 0.5381404044