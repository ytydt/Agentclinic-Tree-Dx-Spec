te Infection: recent cold history could explain leukocytosis, but elevated alkaline phosphatase is atypical for a simple reactive process", "Hyperparathyroidism: elevated calcium (10.9 mEq/L) raises suspicion, but no parathyroid hormone data available to confirm this mechanism", "B2 (danger score 0.8): unspecified but high-risk myeloproliferative alternative with unresolved evidence"], "alarm_features": ["Unintentional weight loss", "Fatigue with systemic involvement", "Elevated white blood cell count with abnormal alkaline phosphatase"]}, "branches": {"B1": {"id": "B1", "label": "Myeloid Neoplasm with Increased Blasts", "level": 1, "status": "closed_for_now", "posterior": 0.001, "danger": 0.8, "parent": "ROOT", "closure_reason": "", "evidence_against": ["Elevated LAPS is more characteristic of chronic myeloproliferative disorders (B3) than acute myeloid blast disease, but the effect is modest."]}, "B2": {"id": "B2", "label": "Lymphoid Neoplasm with Increased Blasts", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.1446994630362936, "posterior": 0.27221070490591914, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": ["Absence of lymphoid-specific markers moderately supports against acute lymphoid blast disease (B2) as the primary diagnosis."], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": ["acute lymphoblastic leukemia", "lymphoblastic lymphoma"]}, "B3": {"id": "B3", "label": "Chronic Myeloproliferative Neoplasm", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.6640736452274422, "posterior": 0.6046382304388195, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": ["Elevated LAPS combined with normal differential weakly supports