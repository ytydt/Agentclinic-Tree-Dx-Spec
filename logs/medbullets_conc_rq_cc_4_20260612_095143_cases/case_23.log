es", "Peripherally driven vascular syndrome: weak pulses could suggest peripheral disease but systolic murmur and systemic hypertension are stronger cardiac indicators"], "alarm_features": ["Hypertensive emergency (197/128 mmHg)", "Uncharacterised systolic murmur (aortic stenosis suspicion)", "Risk factors for cardiovascular disease (HTN, diabetes, dyslipidemia, age)"]}, "branches": {"B1": {"id": "B1", "label": "Gastrointestinal Obstruction", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.4, "posterior": 0.4, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.5, "diagnosis_commitment_gain": 0.75, "interrupt_relevance": 0.8, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B2": {"id": "B2", "label": "Cardiac Dysfunction with Secondary GI Symptoms", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.35, "posterior": 0.35, "danger": 0.9, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B3": {"id": "B3", "label": "Neurological GI Dysfunction", "level": 1, "status": "parked", "posterior": 0.1, "danger": 0.6, "parent": "ROOT", "closure_reason": "", "evidence_against": []}, "B4": {"id": "B4", "label": "Infectious Gastroenteritis", "level": 1, "status": "parked", "posterior": 0.08, "danger": 0.3, "parent": "ROOT", "closure_reason": "", "evidence_against": []}}, "frontier": ["B1", "B2"], "other_mass": 0.0, "pending_results": [], "actions_taken": [], "differential_history": [], "deliberation": {}, "interrupt": {"active": false, "reason