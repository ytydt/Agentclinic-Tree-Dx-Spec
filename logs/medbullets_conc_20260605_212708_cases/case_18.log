cluded_candidates": ["Ectopic Pregnancy: High suspicion due to sexual activity but less consistent with acute right upper quadrant localization", "Alcoholic Hepatitis: Possible given heavy alcohol intake, but hemodynamic instability is less typical for isolated liver disease", "Gallbladder Perforation: Consistent with RUQ pain and shock, but weight loss/history of gonococcal urethritis add nuance", "Pancreatitis: Possible with alcohol use but upper quadrant vs epigastric localization pattern discrepancy"], "alarm_features": ["Hypotension", "Tachycardia", "10/10 right upper quadrant tenderness"]}, "branches": {"B1": {"id": "B1", "label": "Gynecologic Emergency with Hemodynamic Compromise", "level": 1, "status": "parked", "posterior": 0.115, "danger": 0.9, "parent": "ROOT", "closure_reason": "", "evidence_against": ["History of untreated urethritis increases risk for septic embolism, providing weak but specific support for hepatic vascular occlusion (B2). No direct impact o…"]}, "B2": {"id": "B2", "label": "Hepatic Vascular Occlusion with Acute Abdominal Compromise", "parent": "ROOT", "level": 1, "status": "expanded", "prior": 0.0, "posterior": 0.5806451612903225, "danger": 0.85, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.5, "evidence_for": ["The findings of subacute RUQ pain progressing to sudden exacerbation with exercise and absence of fever/jaundice provide MODERATE support for hepatic vascular …"], "evidence_against": ["Absence of fever/jaundice provides minimal reassurance against septic/endocrinopathy (B2) but doesn't disprove the possibility of a non-infectious vascular pro…"], "unresolved_questions": [], "children": ["B2.1", "B2.2", "B2.3"], "closure_reason": "", "turn_cost_to_refine": 3.0, "diagnosis_commitment_gain": 0.25, "interrupt_relevance": 0.75, "level_role": "family", "classification_axis": "anatomy"}, "B3": {"id": "B3", "label": "Acute Biliary Tract Disease Including Choledocholithiasis", "parent": "ROOT", "level": 1, "stat