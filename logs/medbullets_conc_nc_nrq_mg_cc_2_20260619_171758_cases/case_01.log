stitutional weight loss", "Apical risk factors (smoking + alcohol + steroid use)", "Neuropathic pain component"]}, "branches": {"B1": {"id": "B1", "label": "Malignant Neoplasm of the Thoracic Apices", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.3545454545454546, "posterior": 0.3545454545454546, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 2.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.9, "level_role": "family", "classification_axis": "anatomy", "representative_diseases": []}, "B2": {"id": "B2", "label": "Brachial Plexus Injury or Compression", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.2272727272727273, "posterior": 0.2272727272727273, "danger": 0.6, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.5, "diagnosis_commitment_gain": 0.7, "interrupt_relevance": 0.7, "level_role": "family", "classification_axis": "mechanism", "representative_diseases": []}, "B3": {"id": "B3", "label": "Ischemic Cerebrovascular Disease", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.13636363636363638, "posterior": 0.13636363636363638, "danger": 0.8, "actionability": 0.0, "explanatory_coverage": 0.0, "expand_score": 0.0, "evidence_for": [], "evidence_against": [], "unresolved_questions": [], "children": [], "closure_reason": "", "turn_cost_to_refine": 1.0, "diagnosis_commitment_gain": 0.8, "interrupt_relevance": 0.95, "level_role": "family", "classification_axis": "etiology", "representative_diseases": []}, "B4": {"id": "B4", "label": "Thoracic Outlet Syndrome", "parent": "ROOT", "level": 1, "status": "live", "prior": 0.09090909090909093, "posterior": 0.09090909090909093, "danger": 0.4, "actionability":