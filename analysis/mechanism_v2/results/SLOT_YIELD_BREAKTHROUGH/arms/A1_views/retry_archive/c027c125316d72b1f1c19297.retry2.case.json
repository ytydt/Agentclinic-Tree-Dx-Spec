      {
        "candidate_id": "R1",
        "why": "ANCA/MPO positivity is present, but Wegener's requires granulomatous inflammation and typical respiratory/renal involvement, which are absent; P-ANCA is borderline."
      },
      {
        "candidate_id": "R2",
        "why": "Polyarteritis nodosa is a medium-vessel vasculitis with systemic features; biopsy shows dermal small-vessel leukocytoclastic pattern, and MPO-ANCA/methimazole exposure favor ANCA-associated small-vessel vasculitis."
      },
      {
        "candidate_id": "R3",
        "why": "ANA and anti-SSA/Ro are present, but ANA is low-titer, complement is normal, and markedly elevated MPO-ANCA with methimazole exposure is more consistent with ANCA-associated vasculitis than lupus."
      },
      {
        "candidate_id": "R5",
        "why": "Same histopathologic evidence as R4 but less specific; R4's leukocytoclastic qualifier is directly supported."
      },
      {
        "candidate_id": "R6",
        "why": "Erythema induratum is a lobular panniculitis typically associated with TB; biopsy shows dermal vasculitis, not panniculitis, and no TB evidence."
      }
