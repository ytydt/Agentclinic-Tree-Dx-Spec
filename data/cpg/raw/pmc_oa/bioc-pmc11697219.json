          {
            "bioctype": "BioCPassage",
            "offset": 2847,
            "infons": {
              "file": "alr23441-tbl-0001.xml",
              "id": "alr23441-tbl-0001",
              "section_type": "TABLE",
              "type": "table_footnote"
            },
            "text": "For S. aureus, isolates with a minimally inhibitory concentration (MIC) of <0.001 mg/L were considered sensitive to levofloxacin, those with MICs between 0.001 and 1 mg/L were considered intermediary, and those with MICs >1 mg/L were considered resistant. For P. aeruginosa, isolates with MIC levels of >8 mg/L were considered resistant against ceftazidim.",
            "sentences": [],
            "annotations": [],
            "relations": []
          },
          {
            "bioctype": "BioCPassage",
            "offset": 3210,
            "infons": {
              "file": "alr23441-tbl-0001.xml",
              "id": "alr23441-tbl-0001",
              "section_type": "TABLE",
              "type": "table_footnote"
            },
            "text": "Isolates with an efficiency of plating <0.01 were considered resistant, and those with an efficiency of plating >0.01 were considered sensitive.",
