<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://www.statpearls.com/articlelibrary/commentarticle/17974/?utm_source=pubmed&#x00026;utm_campaign=comments&#x00026;utm_content=17974">Comment on this article.</ext-link>
</p>
          </list-item>
        </list>
      </sec>
