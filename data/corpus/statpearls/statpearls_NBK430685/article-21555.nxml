              <tr style="height: 37px;">
                <td style="height: 37px; width: 481px;" rowspan="1" colspan="1">
<p>Poliomyelitis&#x000a0;<xref ref-type="bibr" rid="article-21555.r237">[237]</xref><xref ref-type="bibr" rid="article-21555.r238">[238]</xref><xref ref-type="bibr" rid="article-21555.r239">[239]</xref></p>
