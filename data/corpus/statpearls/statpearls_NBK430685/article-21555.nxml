<p>R</p>
</td>
                <td style="height: 37px; width: 53px;" rowspan="1" colspan="1">
</td>
                <td style="height: 37px; width: 953px;" rowspan="1" colspan="1">
<p>Encephalitis, meningitis</p>
</td>
              </tr>
              <tr style="height: 37px;">
                <td style="height: 37px; width: 481px;" rowspan="1" colspan="1">
<p>Syphilis&#x000a0;<xref ref-type="bibr" rid="article-21555.r247">[247]</xref><xref ref-type="bibr" rid="article-21555.r248">[248]</xref><xref ref-type="bibr" rid="article-21555.r249">[249]</xref><xref ref-type="bibr" rid="article-21555.r250">[250]</xref><xref ref-type="bibr" rid="article-21555.r251">[251]</xref></p>
