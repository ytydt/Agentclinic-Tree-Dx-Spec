      <ref-list id="article-24747.s12">
        <title>References</title>
        <ref id="article-24747.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>Eichhorn Bilodeau</surname>
                <given-names>S</given-names>
              </name>
              <name>
                <surname>Wu</surname>
                <given-names>BS</given-names>
              </name>
              <name>
                <surname>Rufyikiri</surname>
                <given-names>AS</given-names>
              </name>
