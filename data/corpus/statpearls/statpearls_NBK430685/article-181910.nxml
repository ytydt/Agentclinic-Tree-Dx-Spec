</td>
                <td rowspan="1" colspan="1">
<p>If incomplete excision</p>
</td>
                <td rowspan="1" colspan="1">
<p>Moderate</p>
</td>
                <td rowspan="1" colspan="1">
<p>Frequent or premature corticosteroid use</p>
</td>
              </tr>
