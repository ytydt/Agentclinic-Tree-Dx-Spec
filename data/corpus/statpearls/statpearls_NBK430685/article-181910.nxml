</td>
                <td rowspan="1" colspan="1">
<p>Frequent, globe-threatening</p>
</td>
                <td rowspan="1" colspan="1">
<p>Rare</p>
</td>
                <td rowspan="1" colspan="1">
<p>Rare</p>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">
<p><bold>Endothelial plaque or AC invasion</bold></p>
</td>
                <td rowspan="1" colspan="1">
<p>Early &#x00026; aggressive</p>
</td>
                <td rowspan="1" colspan="1">
<p>Moderate</p>
</td>
                <td rowspan="1" colspan="1">
<p>Rare</p>
</td>
              </tr>
              <tr>
                <td rowspan="1" colspan="1">
<p><bold>Graft failure after TPK</bold></p>
</td>
                <td rowspan="1" colspan="1">
