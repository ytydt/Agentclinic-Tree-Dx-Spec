            <p>
<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://mdsearchlight.com/health/pediatric-cerebral-aneurysm/?utm_source=pubmedlink&#x00026;utm_campaign=MDS&#x00026;utm_content=17551">Click here for a simplified version.</ext-link>
</p>
          </list-item>
          <list-item>
            <p>
<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://www.statpearls.com/articlelibrary/commentarticle/17551/?utm_source=pubmed&#x00026;utm_campaign=comments&#x00026;utm_content=17551">Comment on this article.</ext-link>
</p>
          </list-item>
        </list>
      </sec>
