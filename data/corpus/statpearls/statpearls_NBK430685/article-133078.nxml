<p>Developmental care</p>
</td>
              </tr>
              <tr style="height: 35px;">
                <td style="height: 35px;" rowspan="1" colspan="1">
<p>Neurology</p>
</td>
                <td style="height: 35px;" rowspan="1" colspan="1">
<p>Head trauma</p>
</td>
                <td style="height: 35px;" rowspan="1" colspan="1">
<p>Optic nerve evaluation</p>
</td>
              </tr>
              <tr style="height: 35px;">
                <td style="height: 35px;" rowspan="1" colspan="1">
<p>Low vision rehabilitation&#x000a0;</p>
</td>
