                <td style="width: 290.937px;" rowspan="1" colspan="1">
<list list-type="bullet"><list-item><p>Very specific for SLE</p></list-item></list>
</td>
              </tr>
              <tr>
                <td style="width: 129.063px;" rowspan="1" colspan="1">U1-RNP</td>
                <td style="width: 290.937px;" rowspan="1" colspan="1">&#x000a0;20-40%</td>
