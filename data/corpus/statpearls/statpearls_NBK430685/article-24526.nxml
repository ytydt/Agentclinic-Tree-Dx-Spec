<list list-type="bullet"><list-item><p>Associated with neonatal lupus, subacute cutaneous lupus</p></list-item></list>
</td>
              </tr>
              <tr>
                <td style="width: 129.063px;" rowspan="1" colspan="1">Smith (Sm)</td>
