<list list-type="bullet"><list-item><p>Associated with Raynaud phenomenon, lower risk of nephritis</p></list-item><list-item><p>Has an association with MCTD</p></list-item></list>
</td>
              </tr>
              <tr>
                <td style="width: 129.063px;" rowspan="1" colspan="1">Antiphospholipid antibodies&#x000a0;</td>
