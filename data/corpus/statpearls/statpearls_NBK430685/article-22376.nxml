        <table-wrap id="article-22376.table2" position="float" orientation="portrait">
          <caption>
            <title>Table 3. Causes of Hyperuricemia</title>
          </caption>
          <table style="height: 594px; width: 800px;" border="1" cellspacing="1" cellpadding="2">
            <tbody>
              <tr style="height: 40px;">
                <td style="width: 205.96875px; height: 40px;" rowspan="1" colspan="1">
<bold>Clinical disorders leading to urate and/or purine overproduction</bold>
</td>
