        <fig id="article-26083.image.f1" position="float" orientation="portrait">
          <caption>
            <p>Chronic Obstructive Pulmonary Disease, Chest Radiograph. This image shows signs of lung hyperinflation, including flattened hemidiaphragms and a narrow, vertical cardiac silhouette. Contributed by H Shulman, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="20COPDfr" position="float" orientation="portrait"/>
        </fig>
      </floats-group>
