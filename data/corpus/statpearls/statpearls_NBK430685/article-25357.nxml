                <td style="width: 296.599px; text-align: center;" rowspan="1" colspan="1">3 years&#x000a0;</td>
                <td style="width: 368.401px; text-align: center;" rowspan="1" colspan="1">&#x000a0;Age 5 years or earlier if Ctn is elevated</td>
              </tr>
              <tr>
                <td style="width: 18px; text-align: center;" rowspan="1" colspan="1">Moderate</td>
