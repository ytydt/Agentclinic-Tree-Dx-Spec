</td>
                <td style="width: 113px;" rowspan="1" colspan="1">
<p>Malignant</p>
</td>
                <td style="width: 138.594px;" rowspan="1" colspan="1">
</td>
                <td style="width: 663.406px;" rowspan="1" colspan="1">
<p>Hepatocellular carcinoma, cholangiocarcinoma, hepatoblastoma</p>
</td>
              </tr>
