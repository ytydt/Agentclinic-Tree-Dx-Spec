<p>Malignant neoplasms</p>
</td>
                <td style="width: 835.198px;" rowspan="1" colspan="1">
<p>Renal cell carcinoma, Wilms tumor, lymphoma, multiple myeloma</p>
</td>
              </tr>
              <tr>
                <td style="width: 212px;" rowspan="1" colspan="1">&#x000a0;</td>
                <td style="width: 212px;" rowspan="1" colspan="1">
<p>Graft failure</p>
</td>
                <td style="width: 835.198px;" rowspan="1" colspan="1">
<p>Acute, subacute, and chronic</p>
</td>
              </tr>
