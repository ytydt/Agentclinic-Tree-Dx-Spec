      <ref-list id="article-29590.s17">
        <title>References</title>
        <ref id="article-29590.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>Poliner</surname>
                <given-names>A</given-names>
              </name>
              <name>
                <surname>Fernandez Faith</surname>
                <given-names>E</given-names>
              </name>
              <name>
                <surname>Blieden</surname>
