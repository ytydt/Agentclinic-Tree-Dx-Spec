<p><bold>Distinguishing Points</bold></p>
</td>
              </tr>
              <tr>
                <td style="width: 133.102px;" rowspan="1" colspan="1">
<p><bold>Idiopathic</bold></p>
</td>
                <td style="width: 196.898px;" rowspan="1" colspan="1">
