                <td style="width: 163.625px;" rowspan="1" colspan="1">
<p><bold>iPPSDn+1</bold></p>
<p><bold>&#x000a0;</bold></p>
</td>
                <td style="width: 1054.390625px;" rowspan="1" colspan="1">
<p>Newly discovered genetic/molecular defects</p>
</td>
              </tr>
