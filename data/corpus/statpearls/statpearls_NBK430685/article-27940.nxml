            <p>
<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="uri" xlink:href="https://www.statpearls.com/articlelibrary/commentarticle/27940/?utm_source=pubmed&#x00026;utm_campaign=comments&#x00026;utm_content=27940">Comment on this article.</ext-link>
</p>
          </list-item>
        </list>
      </sec>
    </body>
    <back>
      <floats-group id="article-27940.s17">
        <fig id="article-27940.image.f1" position="float" orientation="portrait">
          <caption>
            <p>Pseudohypoparathyroidism. Contributed by O Chaigasame, MD</p>
          </caption>
          <graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="pseudohypoparathyroidism" position="float" orientation="portrait"/>
        </fig>
