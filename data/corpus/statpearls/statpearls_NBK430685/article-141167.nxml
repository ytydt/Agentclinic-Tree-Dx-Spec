                <td style="width: 140.762px; height: 35px;" rowspan="1" colspan="1">
<p>Narrow&#x000a0;or occludable angle</p>
</td>
                <td style="width: 99.2384px; height: 35px;" rowspan="1" colspan="1">
<p>Intermittent &#x02191;</p>
</td>
                <td style="width: 126px; height: 35px;" rowspan="1" colspan="1">
<p>Angle symptoms</p>
</td>
                <td style="width: 149px; height: 35px;" rowspan="1" colspan="1">
<p>Early intervention</p>
</td>
              </tr>
              <tr style="height: 48px;">
                <td style="width: 65px; height: 48px;" rowspan="1" colspan="1">
<p>Stage IV</p>
</td>
