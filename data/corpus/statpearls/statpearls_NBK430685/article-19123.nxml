      <ref-list id="article-19123.s18">
        <title>References</title>
        <ref id="article-19123.r1">
          <label>1</label>
          <element-citation publication-type="journal">
            <person-group>
              <name>
                <surname>Lo</surname>
                <given-names>J</given-names>
