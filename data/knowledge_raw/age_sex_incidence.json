    "myeloid neoplasm (family)": {
      "_note": "§21.13.4 Bug2 fix: broad myeloid family labels (e.g. 'Myeloid Neoplasm with Increased Blasts', 'Chronic Myeloproliferative Neoplasm') would otherwise hit the solid_malignancy 'neoplasm' keyword and get a SOLID-TUMOUR age curve. Checked before categories; gives the (older-skewed) myeloid leukemia curve instead.",
      "keywords": ["myeloid neoplasm", "myeloproliferative", "chronic myeloproliferative", "myelodysplastic"],
      "age_bands": {"0-1": 0.4, "2-12": 0.3, "13-18": 0.4, "19-40": 0.6, "41-60": 1.2, "61-200": 2.0},
      "sex_skew": {"male": 1.1, "female": 0.9}
    },
    "lymphoid neoplasm (family)": {
      "_note": "§21.13.4 Bug2 fix: broad lymphoid-blast family labels (e.g. 'Lymphoid Neoplasm with Increased Blasts' ≈ ALL) are CHILD-peaked; the solid_malignancy curve would invert this (×0.20 in a child). Gives the lymphoblastic (child-peaked) curve.",
      "keywords": ["lymphoid neoplasm", "lymphoblastic"],
      "age_bands": {"0-1": 1.0, "2-12": 1.9, "13-18": 1.1, "19-40": 0.8, "41-60": 0.7, "61-200": 0.9},
