{
  "metadata": {
    "purpose": "Structured age/sex incidence MODIFIERS for the diagnostic PRIOR (not finding LRs). Age & sex are epidemiology: they shift pre-test probability, they are not test results. Multipliers are coarse, monotone-where-appropriate relative weights (1.0 = neutral), grounded in standard epidemiology (e.g. SEER age-specific cancer incidence; textbook onset distributions). Extend by adding categories or disease overrides; keep multipliers RELATIVE and bounded.",
    "age_bands": ["0-1", "2-12", "13-18", "19-40", "41-60", "61-200"],
    "clamp": [0.05, 4.0],
    "sources": "SEER age-specific incidence; Harrison's/UpToDate onset distributions; ACS cancer statistics.",
    "version": 1
  },
  "categories": {
    "solid_malignancy": {
